void main() {
    int N = 10000000;
    int[] is_prime = []; resize(is_prime, N + 1);

    for (int i = 0; i <= N; i = i + 1) {
        is_prime[i] = 1;
    }

    is_prime[0] = 0;
    is_prime[1] = 0;

    for (int p = 2; p * p <= N; p = p + 1) {
        if (is_prime[p] == 1) {
            for (int i = p * p; i <= N; i = i + p) {
                is_prime[i] = 0;
            }
        }
    }

    int count = 0;
    for (int i = 2; i <= N; i = i + 1) {
        if (is_prime[i] == 1) {
            count = count + 1;
        }
    }

    println("Primes up to " + string(N) + ": " + string(count));
}
