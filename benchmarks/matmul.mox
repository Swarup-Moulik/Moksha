void main() {
    int N = 1024;
    int total_elements = N * N;

    float[] A = []; resize(A, total_elements);
    float[] B = []; resize(B, total_elements);
    float[] C = []; resize(C, total_elements);

    for (int i = 0; i < total_elements; i = i + 1) {
        A[i] = 1.0;
        B[i] = 2.0;
        C[i] = 0.0;
    }

    for (int i = 0; i < N; i = i + 1) {
        for (int j = 0; j < N; j = j + 1) {
            float sum = 0.0;
            for (int k = 0; k < N; k = k + 1) {
                sum = sum + (A[(i * N) + k] * B[(k * N) + j]);
            }
            C[(i * N) + j] = sum;
        }
    }

    println("MatMul Complete. C[0] = " + string(C[0]));
}
