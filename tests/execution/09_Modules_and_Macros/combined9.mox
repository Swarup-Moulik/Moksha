int f() { println("f"); return 1; }
int g() { println("g"); return 10; }

void test_execution_contract() {
    // 1. Left-to-Right Guarantee
    // Should print "f", then "g", then "11"
    println(f() + g());

    // 2. Sequential Input Buffering
    println("Enter two numbers:");
    int sum = input("A :- ") + input("B :- ");
    println(`Combined: ${sum}`);
}

test_execution_contract()
macro C(x) { println(`Result: ${x}`); }
macro B(x) { C((x) * 2); }
macro A(x) { B((x) + 1); }

void test_chains_and_shadows() {
    // 1. Multi-level expansion order
    A(5); // Expected: ((5 + 1) * 2) -> "Result: 12"

    // 2. Shadow Chains (Symbol Resolution Depth)
    int x = 1;
    {
        int x = 2;
        {
            int x = 3;
            println(x); // Expected: 3
        }
        println(x);     // Expected: 2
    }
    println(x);         // Expected: 1
}

test_chains_and_shadows()
public int test_multiplier = 5;

public int calculate_magic(int a, int b) {
    return (a + b) * test_multiplier;
}

public class TestConfig {
    public int version;
    constructor(int v) {
        this.version = v;
    }
}
println("--- [E2E] visibility.mox ---")

// Base class defining different access levels
ref class Base {
    public int publicField = 1;
    protected int protectedField = 2;
    private int privateField = 3;

    public void testInternal() {
        // Legal: All members accessible inside their own class
        println(this.publicField);    // Expected: 1
        println(this.protectedField); // Expected: 2
        println(this.privateField);   // Expected: 3
    }
}

// Subclass testing inheritance access
ref class Derived(Base) {
    public void testInheritance() {
        println(this.publicField);    // Expected: 1 (Legal: public)
        println(this.protectedField); // Expected: 2 (Legal: protected is visible to children)

        // ILLEGAL: private not visible to children. Left commented to ensure compilation.
        // println(this.privateField);
    }
}

void test_visibility_enforcement() {
    // --- Top-level Execution (Implicit Main) ---
    // This acts as the "external" context
    Base b = new Base();
    println(b.publicField);    // Expected: 1 (Legal: public)

    // ILLEGAL: protected and private not visible to external caller.
    // println(b.protectedField);
    // println(b.privateField);

    Derived d = new Derived();
    d.testInheritance();
    println(d.publicField);    // Expected: 1 (Legal: public inherited member)
}

test_visibility_enforcement();
