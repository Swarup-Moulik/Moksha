println("--- Moksha Script Mode CLI Test ---");

print("Total script arguments received: ");
println(argc);

// Iterate through the implicitly available double pointer array
for (int i = 0; i < argc; i = i + 1) {
    print("Arg [");
    print(i);
    print("]: ");

    // Extract the *char and safely cast it to a Moksha string
    string arg_str = cast<string>(argv[i]);
    println(arg_str);
}

println("--- Script Test Complete ---");
