println("--- [E2E] macro_hygiene.mox ---")

macro setDouble(target, val) {
    // Hygiene ensures 'internal_temp' becomes something like 'internal_temp_h123'
    // so it can never clash with a variable named 'internal_temp' in the caller's code.
    int internal_temp = val;
    target = internal_temp * 2;
}

void test_hygiene() {
    // 1. Global variable to test that the macro doesn't "leak" its internal temp
    int internal_temp = 100;

    int safeVal = 5;
    int result = 0; // Explicitly initialized to 0

    // 2. Expand: { int internal_temp_hXXX = safeVal; result = internal_temp_hXXX * 2; }
    // The hygiene system MUST preserve the name 'result' as it is a passed argument.
    setDouble(result, safeVal);

    println(result); // Expected: 10

    // 3. This MUST still be 100.
    // If hygiene failed, the macro's 'internal_temp = 5' would have overwritten this.
    println(internal_temp); // Expected: 100
}

test_hygiene();
