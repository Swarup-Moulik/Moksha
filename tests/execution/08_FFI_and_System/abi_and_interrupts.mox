println("--- [E2E] low_level_abi.mox ---")

// Verifies 'extern' parsing and linkage string extraction
extern "C" void printf(string fmt, ...) {
    println(fmt); // Mocking printf with our safe println
}

section(".multiboot") align(4) packed struct MultibootHeader {
    unsigned int magic;
    unsigned int flags;
    unsigned int checksum;
}

// Variables & attributes
volatile unsigned int LAPIC_ID_REG = 0xFEE00020_u32;

void test_low_level() {
    printf("Testing variadic C ABI"); // Expected: Testing variadic C ABI

    mut MultibootHeader header;
    header.magic = 0x1BADB002_u32;
    println(header.magic);            // Expected: 464367618 (0x1BADB002)

    // volatile read
    println(LAPIC_ID_REG);            // Expected: 4276092960 (0xFEE00020)
}

test_low_level();
