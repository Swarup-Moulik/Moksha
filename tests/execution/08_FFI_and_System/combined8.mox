println("--- [E2E] low_level_abi.mox ---")

// Verifies 'extern' parsing and linkage string extraction
extern "C" void printf(string fmt, ...) {
    println(fmt); // Mocking printf with our safe println
}

section(".multiboot") align(4) packed struct MultibootHeader {
    unsigned int magic;
    unsigned int flags;
    unsigned int checksum;
}

// Variables & attributes
volatile unsigned int LAPIC_ID_REG = 0xFEE00020_u32;

void test_low_level() {
    // Wrap the extern function call in an unsafe block
    unsafe {
        printf("Testing variadic C ABI"); // Expected: Testing variadic C ABI
    }

    mut MultibootHeader header;
    header.magic = 0x1BADB002_u32;
    println(header.magic);            // Expected: 464367618 (0x1BADB002)

    // volatile read
    println(LAPIC_ID_REG);            // Expected: 4276092960 (0xFEE00020)
}

test_low_level();
println("--- [E2E] abi_certification_master.mox ---")

// ============================================================================
// 1. FLOAT RETURN ABI
// ============================================================================
extern "C" double return_double_identity(double x);

void test_f64_return() {
    double input1 = 1.23456789;
    unsafe { double output = return_double_identity(input1); }
}

// ============================================================================
// 2. COMPLEX NUMBERS: AGGREGATE VS REGISTER PAIR
// ============================================================================
struct ComplexDouble { double re; double im; }
extern "C" ComplexDouble return_complex_pair();

// ============================================================================
// 3. INTEGER EXTENSION: SIGN vs ZERO EXTENSION
// ============================================================================
extern "C" void takes_signed_char(char c);
extern "C" void takes_unsigned_char(unsigned char c);

// ============================================================================
// 4. THE 256-BIT VECTOR (AVX) & STACK PROBING
// ============================================================================
// Stresses stack alignment beyond 16 bytes. AVX requires 32-byte alignment.
struct Vec256 {
    float f1; float f2; float f3; float f4;
    float f5; float f6; float f7; float f8;
}
extern "C" void pass_vec256(Vec256 v);

// ============================================================================
// 5. NATIVE REFERENCE ABI
// ============================================================================
// Tests passing by native reference (`&`) which should lower to a pointer in LLVM IR
struct RefTarget {
    int x;
}
extern "C" void take_by_ref(&RefTarget c);

void test_native_reference() {
    RefTarget target;
    target.x = 42;
    // Call it to force the compiler to emit the function declaration and struct definition!
    unsafe { take_by_ref(target); }
}

// ============================================================================
// 6. NaN PAYLOAD PRESERVATION
// ============================================================================
// Tests if the backend/optimizer "quiets" or canonicalizes NaNs.
void test_nan_payload() {
    // 0x7FC01234 is a Quiet NaN with a specific payload.
    float nan_val = cast<float>(0x7FC01234_u32);
}

// ============================================================================
// 7. PLT/GOT RELOCATION (DYNAMIC LINKING)
// ============================================================================
// Ensures function calls to external DSOs use the Procedure Linkage Table (PLT).
extern "C" void external_shared_lib_func();

void test_plt_call() {
    unsafe { external_shared_lib_func(); }
}

// ============================================================================
// 8. EVALUATION ORDER BARRIER
// ============================================================================
extern "C" void side_effect(int a, int b);

void test_eval_order() {
    mut int x = 1;
    // ABI + Language Spec must guarantee evaluation order (typically left-to-right).
    unsafe { side_effect(x++, x++); }
}

// ============================================================================
// 9. DWARF CFI & UNWIND METADATA
// ============================================================================
void test_unwind_metadata() {
    println("Verifying CFI (Call Frame Information) emission...");
}

// ============================================================================
// EXECUTION
// ============================================================================
test_nan_payload();
test_eval_order();
test_f64_return();
test_unwind_metadata();
test_native_reference();
test_plt_call();

Vec256 v;
v.f1 = 1.0; v.f8 = 8.0;

unsafe {
    takes_signed_char(-5i8);
    takes_unsigned_char(250u8);
    pass_vec256(v);
    ComplexDouble c = return_complex_pair();
    println(cast<any>(c.re));
}
println("--- [E2E] abi_elite_tier_completion.mox ---")

// ============================================================================
// 1. BROKEN HFA: THE "ONE ROGUE FIELD" TRAP
// ============================================================================
// Homogeneous Floating Aggregates (HFA) are passed in SIMD/XMM registers.
// Adding even ONE non-float field (like an int) breaks this optimization,
// forcing the entire struct into GPRs or Memory.
struct BrokenHFA {
    float a;
    float b;
    int c;   // This breaks HFA status on ARM64/x86_64
}

extern "C" void check_broken_hfa(BrokenHFA s);

// ============================================================================
// 2. REGISTER EXHAUSTION: STACK SPILLING
// ============================================================================
// Stresses the transition from registers to stack memory.
// SysV uses 6 GPRs for integers. Arguments 7 and 8 MUST be on the stack.
extern "C" void spill_args(
    int a1, int a2, int a3, int a4, int a5, int a6, // Registers
    int a7, int a8                                  // Must be Stack
);

void test_arg_spilling() {
    // Verifies that the backend correctly calculates the stack offset for a7/a8
    // and maintains the 16-byte alignment of the caller's frame.
    unsafe { spill_args(1, 2, 3, 4, 5, 6, 7, 8); }
}

// ============================================================================
// 3. INLINE ASM: CONDITION CODE (CC) CLOBBER
// ============================================================================
// Prevents the optimizer from reordering instructions across assembly that
// modifies status flags (EFLAGS).
void test_cc_clobber() {
    int x = 10;
    // Standard Moksha asm syntax.
    // Note: The compiler backend will need to be updated to map local variables to these operands.
    asm("add $$1, $0") inout("+r"(x)) clobber("cc") volatile;
    println(`CC Clobber Check: ${x}`);
}

// ============================================================================
// 4. TLS MODELS: FORCING GLOBAL-DYNAMIC
// ============================================================================
// Stresses thread-local storage models.
thread_local int tls_complex = 42;

void test_tls_dynamic() {
    println(tls_complex);
}

// ============================================================================
// 5. FP ENVIRONMENT: ROUNDING MODE PRESERVATION
// ============================================================================
// The ABI requires that the Floating Point Environment (rounding modes,
// exception flags) remains stable across standard function calls.
extern "C" void set_rounding_downward();
extern "C" int get_rounding_mode();

void test_fp_env() {
    unsafe {
        set_rounding_downward();
        int mode = get_rounding_mode();
        println(`Rounding Mode Preserved: ${mode}`);
    }
}

// ============================================================================
// 6. VARARGS + AGGREGATES
// ============================================================================
// Passing a struct to a variadic function is a common source of
// "hidden" pointer bugs.
struct Small { int a; int b; }

extern "C" int printf(string fmt, ...);

void test_vararg_struct() {
    Small s;
    s.a = 1;
    s.b = 2;
    unsafe { printf("Struct in vararg: %d %d\n", s); }
}

// ============================================================================
// 7. TAIL CALL: STACK GROWTH STABILITY
// ============================================================================
// Validates that deep recursion with tail calls does not cause stack overflow.
extern "C" int tail_recursive_sum(int count, int acc);

void test_tail_call_stability() {
    unsafe {
        int result = tail_recursive_sum(1000000, 0);
        println(`Tail Call Result: ${result}`);
    }
}

// ============================================================================
// EXECUTION
// ============================================================================
test_arg_spilling();
test_cc_clobber();
test_tls_dynamic();
test_fp_env();
test_vararg_struct();
test_tail_call_stability();
println("--- [E2E] abi_final_impossible_suite.mox ---")

// ============================================================================
// 1. NON-HFA VECTORIZABLE STRUCTS (XMM PACKING)
// ============================================================================
// On SysV, this is 128-bit. Stresses the IR generator to ensure it
// lowers to <2 x double> for XMM0 usage, rather than an {i64, i64} aggregate.
struct VecLike {
    double a;
    double b;
}
extern "C" void take_veclike(VecLike v);

// ============================================================================
// 2. BYVAL + ALIGN(32) INTERACTION
// ============================================================================
// Forces the backend to handle over-aligned stack-passed parameters.
// Validates 'byval align 32' in the IR.
align(32) struct BigAligned {
    float[8] data;
}
extern "C" void take_big_aligned(BigAligned b);

// ============================================================================
// 3. FLEXIBLE ARRAY MEMBER (FAM)
// ============================================================================
// ABI rule: sizeof(Packet) must ignore the flexible tail.
// Passing/returning must treat it as a 4-byte (int) header only.
struct Packet {
    int len;
    char[0] data;
}
void test_fam_semantics() {
    println(`FAM Struct Size: ${sizeof(Packet)}`); // Expected: 4
}

// ============================================================================
// 4. UNION ABI CLASSIFICATION
// ============================================================================
// Stresses classification based on the largest member.
// If i32 and float alias, the ABI must decide between GPR and SSE.
union U {
    int i;
    float f;
}
extern "C" void pass_union(U u);

// ============================================================================
// 5. LONG DOUBLE PASSING (SYSV MEMORY VS WIN64 ALIAS)
// ============================================================================
// Cross-platform divergence point: x86_64 SysV uses memory/x87 stack,
// while Windows often aliases this to a 64-bit double.
extern "C" void take_ld(double x);

// ============================================================================
// 6. FUNCTION RETURNING FUNCTION POINTER
// ============================================================================
// Validates CC (Calling Convention) metadata preservation through nesting.
extern "C" (int) => void get_callback();

// ============================================================================
// 7. MULTI-DIMENSIONAL ARRAY DECAY
// ============================================================================
// ABI Rule: int[3][4] must decay to int (*)[4], not int**.
extern "C" void take_2d(int[3][4] arr);

// ============================================================================
// 8. SMALL ENUM WIDTH (EXPLICIT STORAGE)
// ============================================================================
// Validates that Moksha doesn't promote i8 enums to i32 in standard FFI.
enum SmallEnum {
    A = 1
}
extern "C" void pass_small_enum(SmallEnum e);

// ============================================================================
// 9. CROSS-LANGUAGE INTEROP (C VS C++)
// ============================================================================
// Validates layout consistency. In Moksha's Gradient Memory Model,
// we must ensure that a 'class' (value type) or 'ref class' doesn't
// inject unexpected padding compared to a standard C struct. [cite: 2]
extern "C" {
    struct CData { int x; char y; }
}
extern "C++" {
    struct CppData { int x; char y; }
}

// ============================================================================
// 10. ZERO-INITIALIZED TLS (.TBSS VS .TDATA)
// ============================================================================
// Ensures zero-init TLS variables are placed in .tbss to minimize binary size.
thread_local int zero_tls = 0;

// ============================================================================
// 11. WEAK + INLINE + ODR PATHOLOGY
// ============================================================================
// Stresses LTO. If 'foo' is inlined before the weak symbol is resolved,
// it creates a permanent ODR violation.
inline weak void weak_inline_test() {
    println("Default Weak Inline");
}

// ============================================================================
// 12. CALLING CONVENTION + VARARGS (WINDOWS DEGRADATION)
// ============================================================================
// On Windows, 'stdcall' varargs must degrade to 'cdecl' to prevent stack corruption.
extern "stdcall" int win_printf(string fmt, ...);

// ============================================================================
// EXECUTION
// ============================================================================
test_fam_semantics();
println(`TLS Address: ${&zero_tls}`);
