    cpu_core_id = 1;
    println(cpu_core_id);
}

// ============================================================================
// 5. VOLATILE: POINTER VS POINTEE (FIXED)
// ============================================================================
void test_volatile_ast() {
    int target = 42;
    volatile int vol_target = 42; // ADDED: Need a volatile base to point to without unsafe casting.

    // 1. Non-volatile pointer to a volatile integer.
    // FIX: Must point to an actually volatile variable to satisfy strict type checking.
    volatile *mut int p1 = &vol_target;

    // 2. Volatile pointer to a non-volatile integer.
    // FIX: Can point to the standard target, but the pointer itself is volatile.
    *mut volatile int p2 = &target;
}

