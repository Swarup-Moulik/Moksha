void my_callback(int status) {
    println("OS Status: " + string(status));
}

void test_ffi_callbacks() {
    unsafe { register_os_callback(my_callback); }
}

// ============================================================================
// 8. OVER-ALIGNMENT
// ============================================================================
// Forces LLVM to align this struct to a 16-byte boundary, critical for SIMD ops.
align(16) struct SimdData {
    int[4] vectors;
}

void test_over_alignment() {
    SimdData data;
    // Un-testable at runtime without pointer math, but IR should emit `align 16`
}

// ============================================================================
// EXECUTION
