test_variadic_promotion();
test_init_order();
test_over_alignment()
test_ffi_callbacks();
println("--- [E2E] abi_systems_edge_cases.mox ---")

// ============================================================================
// 1. ABI EDGE CASES & CLASSIFICATION
// ============================================================================

// (a) Mixed Integer + Float ABI Passing (Tests GPR vs XMM register splitting)
extern "C" void mixed_args(int a, float b, double c, int d);

// (b) Struct ABI Classification (Register packed vs memory passed)
struct SmallPair { int a; int b; }
struct MixedStruct { int a; float b; }

extern "C" SmallPair return_small_pair();
extern "C" void pass_mixed_struct(MixedStruct m);

// (c) Pass-by-reference ABI (Mutability across boundary)
extern "C" void modify_ptr(*mut int ptr) {
    *ptr = 123;
}

// (d) Variadic Edge Cases (Multiple argument types)
extern "C" int printf(string fmt, ...);

void test_abi_edges() {
    unsafe {
        mixed_args(1, 3.14f32, 2.718, 4);
        SmallPair sp = return_small_pair();

        MixedStruct ms;
        ms.a = 10;
        ms.b = 5.5f32;
        pass_mixed_struct(ms);

        int val = 0;
        modify_ptr(&val);
        println(val); // Expected: 123

        printf("Variadic test: %d, %f, %s\n", 42, 3.14159, "hello");
    }
}

// ============================================================================
// 2. VOLATILE SEMANTICS (Ordering & No-Elision)
// ============================================================================
// Create a real variable in standard memory to act as our "hardware register"
int dummy_hardware_memory = 0;

// Point the volatile pointer to our safe memory
volatile *mut int hardware_reg = &dummy_hardware_memory;

void test_volatile_ordering() {
    *hardware_reg = 10;
    int readback = *hardware_reg;
    *hardware_reg = 1;
    *hardware_reg = 2;
}

// ============================================================================
// 3. UNSAFE / POINTER SYSTEM
// ============================================================================
void test_pointer_system() {
    // Null pointer initialization
    *mut int null_p = null;

    // Pointer arithmetic (p + 1 must add sizeof(int) bytes, not 1 byte)
    *mut int base = cast<*mut int>(0x1000);
    *mut int offset_p = base + 1;

    // Strict Aliasing Violation Test (TBAA in LLVM)
    int x = 42;
    *mut int p_x = &x;
    *mut float p_f = cast<*mut float>(p_x);
    // *p_f = 3.14f; // If uncommented, tests undefined behavior handling / type-punning
}

// ============================================================================
// 4. DEFER SEMANTICS EDGE CASES
// ============================================================================
int test_defer_early_return() {
    int state = 0;
    defer {
        println("Defer on early return executing");
    }
    return state; // Return evaluates, defer executes, then frame pops
}

void test_defer_inside_loops() {
    // Tests scope boundaries for defer.
    // Defers must execute at the end of EACH iteration, not at the end of the function.
    for (int i = 0; i < 2; i = i + 1) {
        defer { println("Defer iter: " + string(i)); }
    }
}

// ============================================================================
// 5. INLINE ASSEMBLY CONSTRAINTS
// ============================================================================
void test_asm_constraints() {
    int in_val = 5;
    int out_val = 0;
    asm("mov $1, ($0)") in("r"(&out_val)) in("r"(in_val));
    println("Asm out: " + string(out_val)); // Expected: 5
}

// ============================================================================
// 6. INTERRUPT ABI & STACK FRAMES
// ============================================================================
struct InterruptFrame {
    int ip;
    int cs;
    int flags;
}

// Tests CPU-pushed parameters for ISRs. The LLVM `x86_intrcc` calling convention
// strictly dictates how this frame is passed and how `iret` is emitted.
interrupt void handle_page_fault(InterruptFrame* frame, int error_code) {
    println("Fault at IP: " + string(frame.ip));
    println("Error code: " + string(error_code));
}

// ============================================================================
// 7. FREESTANDING / GLOBAL INITIALIZATION ORDER
// ============================================================================
// Tests LLVM `.init_array` / `@llvm.global_ctors` linking correctness.
int init_global_x() { println("Init X"); return 100; }
int init_global_y() { println("Init Y"); return 200; }

int global_x = init_global_x();
int global_y = init_global_y();

// ============================================================================
// 8. WEAK SYMBOL OVERRIDE
// ============================================================================
weak void default_handler() {
    println("Weak handler (Should NOT print)");
}

// ============================================================================
// 9. TYPE SYSTEM ABI INTEROP
// ============================================================================
enum Status { OK = 0, FAIL = 1 }

extern "C" void log_status(Status s);    // Checks if Enum lowers to correct integer type ABI
extern "C" void enable_feature(bool b);  // Checks bool ABI (i1 vs i8 promotion in C ABI)

// ============================================================================
// 10. ALIGNMENT & PACKING
// ============================================================================
packed struct UnalignedHeader {
    char magic;       // 1 byte
    int payload_size; // 4 bytes
}

void test_alignment_packing() {
    // If not packed, ABI padding makes this 8 bytes.
    // Because it is [packed], it MUST be exactly 5 bytes.
    println("Packed size: " + string(sizeof(UnalignedHeader))); // Expected: 5
}

// ============================================================================
// EXECUTION
// ============================================================================
test_abi_edges();
test_volatile_ordering();
test_pointer_system();
test_defer_early_return();
test_defer_inside_loops();
test_asm_constraints();
default_handler(); // Expected to print the Strong version
test_alignment_packing();
println("--- [E2E] abi_torture.mox ---")

// We define the externs locally so the Clang linker doesn't fail on Windows.
extern "stdcall" void win32_api(int a, int b) {
    println(`win32_api: ${a + b}`);
}

extern "fastcall" void x64_sysv_abi(int a, int b, int c, int d) {
    println(`sysv_abi: ${a + b + c + d}`);
}

struct BigData { long[16] data; }
BigData get_kernel_table() {
    mut BigData bd;
    bd.data[0] = 999_i64;
    return bd;
}

struct Vector4 { float x; float y; float z; float w; }
void process_vector(Vector4 v) {
    println(v.x);
}

void test_abi_lowering() {
    unsafe {
        win32_api(10, 20);                  // Expected: win32_api: 30
        x64_sysv_abi(1, 2, 3, 4);           // Expected: sysv_abi: 10
    }

    BigData tbl = get_kernel_table();
    println(tbl.data[0]);                   // Expected: 999

    Vector4 vec;
    vec.x = 3.14;
    process_vector(vec);                    // Expected: 3.14
}

test_abi_lowering();
// Compilation Unit B
struct Foo {
    int a;
    float b;
}

extern Foo make_foo(int x, float y);

void test_ctu_consistency() {
    unsafe {
        Foo f = make_foo(10, 3.14);

        if (f.a == 10) {
            println("CTU Consistency: SUCCESS");
        } else {
            println("CTU Consistency: FAILED");
        }
    }
}

test_ctu_consistency();
// Compilation Unit A
struct Foo {
    int a;
    float b;
}

// Ensure this lowers to a GPR (a) and an XMM (b) consistently
extern "C" Foo make_foo(int x, float y) {
    Foo f;
    f.a = x;
    f.b = y;
    return f;
}
println("--- [E2E] c_strings.mox ---")

void test_valid_c_strings() {
    // 1. 1D Array with String Literal (Exact fit)
    char[6] str1 = "Hello";

    // 2. 1D Array with String Literal (Loose fit - padded with nulls)
    char[10] str2 = "Hi";

    // 3. 1D Array with Char Array Literal
    char[6] str3 = ['H', 'e', 'l', 'l', 'o', '\0'];

    // 4. 2D Array with String Literals
    char[2][10] arr1 = ["Hello ", "World !"];

    // 5. Implicit String Decay and Printing
    string decayed_str = str1;

    // Testing native string printing for char[n] arrays
    println(str1);        // Expected: Hello
    println(decayed_str); // Expected: Hello
    println(str3);        // Expected: Hello

    // 6. Safe Reassignment
    str2 = "Reassign";
    println(str2);        // Expected: Reassign
}

test_valid_c_strings();
println("--- [E2E] defer_and_unsafe.mox ---")

void test_defer_logic() {
    int x = 10;

    // Defers are executed in LIFO (Last-In, First-Out) order
    defer { println(`Deferred 1: ${x}`); }
    defer { println(`Deferred 2: ${x}`); }

    x = x + 10;
    println(`Normal execution: ${x}`);
}

void test_systems() {
    int val = 42;
    unsafe {
        *mut int ptr = &val;
        *ptr = 99;
    }
    println(val); // Expected: 99
}

test_defer_logic();
// Expected: Normal execution: 20
// Expected: Deferred 2: 20
// Expected: Deferred 1: 20

test_systems();
println("--- [E2E] final_abi_torture_master.mox ---")

// ============================================================================
// 1. ABI CLASSIFICATION: THE MEMORY FALLBACK TRAP
// ============================================================================
// SysV Rule: If a struct has an SSE + INTEGER mix across the same 8-byte boundary,
// or exceeds register slots, it MUST fall back to 'sret' (memory)[cite: 7, 8, 30].
struct WeirdCollision {
    double a;  // Slot 0: SSE
    int b;     // Slot 1: INTEGER
    double c;  // Slot 1/2: SSE (Collides with Slot 1)
}

extern "C" WeirdCollision return_weird();

// ============================================================================
// 2. SRET & BYVAL: LLVM ATTRIBUTE VALIDATION
// ============================================================================
struct HugeData { long[16] data; } // [cite: 100]

// Verifies that 'HugeData' is returned via hidden sret pointer
extern "C" HugeData return_huge_sret();

// Verifies that 'BigData' is passed via 'byval' (caller-allocated stack copy)
extern "C" void take_huge_byval(HugeData d);

// ============================================================================
// 3. FLOATING POINT & SIMD: THE NATIVE REGISTER PATH
// ============================================================================
// On SysV, 'long double' (80-bit x87) is passed via ST0, not XMM[cite: 31, 32].
extern "C" double pass_ld(double x);

// Verifies 'vector' attribute lowers to LLVM <4 x float>, NOT an aggregate struct.
struct Float4 { float x; float y; float z; float w; }
extern "C" void pass_true_vector(Float4 v);

// ============================================================================
// 4. CALLER-SAVED & RED ZONE STRESS
// ============================================================================
extern "C" void clobber_registers();

void test_reg_preservation() {
    int x = 42;
    unsafe { clobber_registers(); }
    println(`Preservation check: ${x}`);
}

// x86_64 SysV has a 128-byte 'Red Zone' below RSP.
// ISRs MUST NOT use the red zone as the CPU hardware interrupts don't respect it[cite: 45, 83].
interrupt naked void check_red_zone_safety() {
    // Backend MUST NOT emit red-zone-using code here.
    asm("push %rax");
    asm("pop %rax");
    asm("iretq");
}

// ============================================================================
// 5. CALLING CONVENTION & INDIRECT MISMATCHES
// ============================================================================
extern "stdcall" void win32_func(int a); // [cite: 98]
extern "C" void c_func(int a);           // [cite: 1]

void test_cc_mismatch() {
    // RED TEAM: This cast should ideally be caught by the type system,
    // but we test if the indirect call correctly lowers to 'call stdcall' vs 'call ccc'.
    (int) => void fp = cast<(int) => void>(win32_func);
    // fp(10); // UB if called as C-convention
}

// ============================================================================
// 6. TAIL CALL & VARARG REG-SAVE-AREA
// ============================================================================
extern "C" int terminal_callee(int x);

int test_tail_call(int x) {
    unsafe { return terminal_callee(x); }
}

extern "C" int printf(string fmt, ...); // [cite: 35, 61]
void test_vararg_spill() {
    unsafe { printf("%d %f %d %f %d %f", 1, 1.1, 2, 2.2, 3, 3.3); }
}

// ============================================================================
// 7. BITCAST VS CONVERSION
// ============================================================================
void test_bitcast() {
    unsigned int raw_bits = 0x3f800000_u32;
    // bitcast must NOT generate 'cvtsi2ss'. It must generate 'movd' or IR bitcast.
    float f = bitcast<float>(raw_bits);
    println(`Bitcast 1.0: ${f}`);
}

// ============================================================================
// 8. VOLATILE BARRIERS & ALIASING
// ============================================================================
volatile int barrier_x;
volatile int barrier_y;

void test_volatile_reordering() {
    // IR must strictly maintain this order to prevent hardware hazards[cite: 68, 69].
    barrier_x = 100;
    barrier_y = 200;
}

void test_strict_aliasing() {
    int x = 0;
    // TBAA Metadata check: If the compiler assumes 'int' and 'float' don't alias,
    // the optimizer might incorrectly reorder these stores[cite: 73, 74].
    *mut float p_f = cast<*mut float>(&x);
    *p_f = 1.0f32;
    // println(x);
}

// ============================================================================
// 9. CROSS-MODULE ODR / TLS
// ============================================================================
// TU-1 defines 'Foo' with 'int'. TU-2 defines 'Foo' with 'float'.
// Moksha must detect this mismatch during linking or CTU analysis[cite: 105, 108].
struct Node {
    int val;
    *mut Node next; // Recursive type layout check [cite: 71, 72]
}

thread_local int tls_primary = 1;
// Verifies 'initial-exec' vs 'global-dynamic' models[cite: 21].
thread_local int tls_dependent = tls_primary + 1;

// ============================================================================
// MISSING TEST WRAPPERS
// ============================================================================

void test_memory_fallback() {
    unsafe {
        WeirdCollision w = return_weird();
        println(`Memory fallback: a=${w.a}, b=${w.b}, c=${w.c}`);
    }
}

void test_sret_byval() {
    unsafe {
        HugeData h = return_huge_sret();
        println(`SRET data check: ${h.data[15]}`); // Expected: 165
        take_huge_byval(h);
    }
}

void test_simd_vectors() {
    Float4 v;
    v.x = 1.1; v.y = 2.2; v.z = 3.3; v.w = 4.4;
    unsafe { pass_true_vector(v); }
}

// ============================================================================
// EXECUTION
// ============================================================================
test_reg_preservation();
test_vararg_spill();
test_bitcast();
test_memory_fallback();  // <-- Added
test_sret_byval();       // <-- Added
test_simd_vectors();     // <-- Added
test_tail_call(100);     // <-- Added call to existing test
test_cc_mismatch();      // <-- Added call to existing test
test_volatile_reordering();
test_strict_aliasing();
println("--- [E2E] intrinsics.mox ---")

macro GET_SIZE(obj) {
    sizeof(obj)
}

void test_intrinsics() {
    unsigned int data = 0x000000FF_u32;

    // 1. Bit Manipulation Intrinsics
    unsigned int reversed = bswap32(data);
    int leading_zeros = clz(data);

    println(reversed);      // Expected: 4278190080 (0xFF000000)
    println(leading_zeros); // Expected: 24

    // 2. SizeOf Expression (Evaluates to usize)
    usize data_size = sizeof(data);
    println(data_size);     // Expected: 4

    // 3. Macro expansion of sizeof
    println(GET_SIZE(data)); // Expected: 4
}

test_intrinsics();
println("--- [E2E] isr_safety.mox ---")

// 'pure' guarantees no side effects, allowing the MIR optimizer to fold/memoize
pure int compute_hash(int input_data) {
    return (input_data * 16777619) ^ 2166136261;
}

// 'inline' aggressively pushes this into the caller's MIR block
inline int quick_status_check() {
    return 1;
}

// ISRs compiled to test LLVM x86_intrcc lowering (bypassed at runtime)
interrupt void handle_keyboard_isr() {
    // Intentionally empty for safe linkage
}

naked noreturn void cpu_halt() {
    asm("cli");
    asm("1: hlt; jmp 1b");
}

void test_isr_safety() {
    println(compute_hash(42));       // Expected: Computed Hash Output
    println(quick_status_check());   // Expected: 1
}

test_isr_safety();
println("--- [E2E] linkage_and_abi.mox ---")

// Weak symbols (Allowing user-overrides for drivers)
weak void default_irq_handler() {
    println("Default IRQ Handler executed");
}

// Verifies 'used' attribute (prevents DCE in optimizer)
used section(".metadata") static int kernel_version = 1;

// Verifies complex section names (linker script compatibility)
section(".init.text") void arch_init() {
    println("Architecture initialized");
}

void test_linkage() {
    default_irq_handler(); // Expected: Default IRQ Handler executed
    arch_init();           // Expected: Architecture initialized
    println(kernel_version); // Expected: 1
}

test_linkage();
void test_volatile_aliasing() {
    volatile int target = 0;
    *mut int p_normal = cast<*mut int>(&target);
    *mut volatile int p_vol = &target;

    // The optimizer might think 'p_normal' is a standard store and
    // attempt to coalesce it with 'p_vol'.
    // Your IR must strictly maintain 'load volatile' and 'store volatile'.
    *p_normal = 10;
    *p_vol = 20;

    int val = *p_normal;
    print(val); // Must print '20'
}

test_volatile_aliasing()
println("--- [E2E] volatile_mmio.mox ---")

void test_mmio() {
    // 1. Setup a safe local memory address to act as our "Hardware Register"
    unsigned int dummy_uart = 0_u32;
    *mut unsigned int safe_ptr = &dummy_uart;
    usize hardware_addr = cast<usize>(safe_ptr);

    // 2. MMIO: Casting the integer address to a mutable volatile pointer
    *mut volatile unsigned int uart0 = cast<*mut volatile unsigned int>(hardware_addr);

    // 3. Verifies that TypeChecker allows writes to *mut volatile pointers
    unsafe {
        *uart0 = cast<unsigned int>('A'); // ASCII 65
    }

    println(dummy_uart); // Expected: 65
}

test_mmio();
