println("--- [E2E] all_pointers.mox ---");

void test_active_pointers() {
    // 1. Basic Mut Pointers
    int data = 42;
    *mut int ptr = &data;
    *ptr = 100;
    println(data); // Expected: 100

    // 2. View Pointers
    *view int v_ptr = &data;
    println(*v_ptr); // Expected: 100

    // 3. Multi-Level Pointers
    int deep_data = 999;
    *mut int l1 = &deep_data;
    *mut *mut int l2 = &l1;
    **l2 = 888;
    println(deep_data); // Expected: 888

    // 4. Function Pointers
    // Using Moksha's closure syntax as function pointers
    closure(int, int) -> int add = (int a, int b) => { return a + b; };
    *view closure(int, int) -> int fn_ptr = &add;

    // Deref and call
    int res = (*fn_ptr)(10, 20);
    println(res); // Expected: 30
}

void test_all_pointers() {
    println("--- Testing Extensive Pointer Types ---");

    // --- 1. Void and Boolean ---
    *void void_ptr = null;
    *bool bool_ptr = null;
    println(void_ptr);
    println(bool_ptr);

    // --- 2. Character and Strings ---
    *char char_ptr = null;
    *unsigned char uchar_ptr = null;
    *string str_ptr = null;
    println(char_ptr);
    println(uchar_ptr);
    println(str_ptr);

    // --- 3. Standard Signed Integers ---
    *short short_ptr = null;
    *int int_ptr = null;
    *long long_ptr = null;
    println(short_ptr);
    println(int_ptr);
    println(long_ptr);

    // --- 4. Standard Unsigned Integers ---
    *unsigned short ushort_ptr = null;
    *unsigned int uint_ptr = null;
    *unsigned long ulong_ptr = null;
    println(ushort_ptr);
    println(uint_ptr);
    println(ulong_ptr);

    // --- 5. Floating Point Numbers ---
    *float float_ptr = null;
    *double double_ptr = null;
    println(float_ptr);
    println(double_ptr);

    // --- 6. Opaque / Dynamic Types ---
    *any any_ptr = null;
    println(any_ptr);

    // --- 7. Multi-Level Pointers (Testing prefix capability nesting) ---
    // Mutable pointer to a read-only pointer to an int
    *mut *view int double_int_ptr = null;

    // Deep raw pointer
    * * *void triple_void_ptr = null;

    // Synchronized pointer to a mutable string pointer
    *lock *mut string thread_safe_str_ptr = null;
    println(double_int_ptr);
    println(triple_void_ptr);
    println(thread_safe_str_ptr);

    // --- 8. Arrays of Pointers (*T[]) ---
    // Array of 10 read-only int pointers
    *int[10] array_of_int_ptrs = null;

    // Array of 5 mutable float pointers
    *mut float[5] array_of_mut_float_ptrs = null;
    println(array_of_int_ptrs);
    println(array_of_mut_float_ptrs);

    // --- 9. Pointers to Arrays (* (T[])) ---
    // Read-only pointer to an array of 10 ints
    *int[10] ptr_to_int_array = null;

    // Mutable pointer to a 256-byte character buffer
    *mut char[256] ptr_to_mut_char_buffer = null;
    println(ptr_to_int_array);
    println(ptr_to_mut_char_buffer);

    println("All extensive pointer types compiled and printed directly!");
}

test_active_pointers();
test_all_pointers();
println("--- [E2E] arc_destructor_interaction.mox ---")

ref class Mutex {
    public int id;
    constructor(int id) { this.id = id; }
    destructor() { println(`Mutex ${this.id} released system lock`); }
}

void test_no_elision() {
    Mutex m = new Mutex(42);
    {
        // Because Mutex has a custom destructor with side effects,
        // ARCAnalyzer CANNOT elide the retain/release pair here.
        // Copying it creates a second strong reference.
        Mutex copy = m;
    }
    // Block ends -> 'copy' is released, but 'm' still has 1 retain count,
    // so the destructor does NOT fire yet.
    println("Scope exited, Mutex still alive");
}

test_no_elision();
// Expected: Scope exited, Mutex still alive
// Expected: Mutex 42 released system lock
println("--- [E2E] arc_early_return.mox ---")

ref class Resource {
    public int id;
    constructor(int id) { this.id = id; }
    destructor() { println(`Freed Resource ${this.id}`); }
}

void testEarlyReturn(bool trigger) {
    Resource r1 = new Resource(1);

    if (trigger) {
        Resource r2 = new Resource(2);
        // ARC pass MUST insert a drop for `r2` AND `r1` here before returning.
        return;
    }

    // ARC pass MUST insert a drop for `r1` here.
}

println("Testing true branch:");
testEarlyReturn(true);
// Expected: Freed Resource 2
// Expected: Freed Resource 1

println("Testing false branch:");
testEarlyReturn(false);
// Expected: Freed Resource 1
println("--- [E2E] arc_exception_path.mox ---")

ref class DbConnection {
    destructor() { println("Database connection closed during unwind"); }
}

void risky_operation() {
    println("Doing risky work...");
    throw 99; // Mock throwing an exception
}

void test_unwind() {
    DbConnection conn = new DbConnection();

    try {
        risky_operation(); // This will generate an 'invoke' instruction
        println("This will not print");
    } catch (int e) {
        println(`Caught exception: ${e}`);
    }

    // The connection drops AFTER the catch block finishes
}

test_unwind();
// Expected: Doing risky work...
// Expected: Caught exception: 99
// Expected: Database connection closed during unwind
println("--- [E2E] arc_loop_elision.mox ---")

ref class PureNode {
    // No custom destructor, so ARCAnalyzer IS allowed to elide pure pairs!
    public int data;
    constructor() { this.data = 100; }
}

void test_loop_elision() {
    PureNode s = new PureNode();
    int i = 0;

    while (i < 10) {
        // The Inserter will naively put a Retain/Release here.
        // The Analyzer MUST delete them because 'copy' never escapes the loop
        // and PureNode has no custom drop() side-effects!
        PureNode copy = s;
        i = i + 1;
    }

    // If it survives the loop without double-freeing or leaking, elision works.
    println(s.data); // Expected: 100
}

test_loop_elision();
println("--- [E2E] arc_pair_elision.mox ---")

ref class CycleState {
    public int id;
    constructor(int id) { this.id = id; }
}

void test_elision_and_phi(bool cond) {
    CycleState c1 = new CycleState(1);
    CycleState c2 = new CycleState(2);

    {
        // ARCInserter WILL add retain(copy) and release(copy) here
        // ARCAnalyzer WILL delete them because no side-effects happen!
        CycleState copy = c1;
    }

    // The naive inserter will retain the result of the Phi node.
    // The analyzer must see it's never escaped and elide it.
    CycleState result = cond ? c1 : c2;

    println(result.id);
}

test_elision_and_phi(true);  // Expected: 1
test_elision_and_phi(false); // Expected: 2
println("--- [E2E] arc_weak_refs.mox ---")

ref class Node {
    public string name;
    public weak Node? parent; // Weak reference to prevent cycle
    public Node? child;

    constructor(string n) {
        this.name = n;
        this.parent = null;
        this.child = null;
    }

    destructor() {
        println(`Node ${this.name} destroyed`);
    }
}

void test_weak_arc() {
    Node p = new Node("Parent");
    Node c = new Node("Child");

    // The MIR lowerer must correctly emit weak variants of the ARC instructions
    c.parent = p;
    p.child = c;

    println(p.child?.name ?? "null");  // Expected: Child

    // When test_weak_arc returns, 'p' and 'c' go out of scope.
    // 'c' has 1 strong ref (from p). 'p' has 0 strong refs (only a weak ref from c).
    // Therefore, 'p' drops, triggering 'c' to drop, successfully resolving the cycle!
}

test_weak_arc();
// Expected: Node Parent destroyed
// Expected: Node Child destroyed
println("--- [E2E] borrow_of_reference.mox ---")

void test_chain() {
    int data = 10;
    *mut int m1 = &data;

    // Reborrow from the reference itself
    *view int v = &*m1;

    int read = *v;
    println(read); // Expected: 10

    // 'v' dies here, releasing the view borrow.

    *m1 = 20; // Safe to use m1 again!
    println(data); // Expected: 20
}

test_chain();
println("--- [E2E] borrow_state_transitions.mox ---")

void test_borrow_transitions() {
    int x = 10;

    // View borrows are established
    *view int v1 = &x;
    *view int v2 = &x;
    int read_val = *v1 + *v2;
    println(read_val); // Expected: 20

    // Test: *mut is allowed because previous views are dead
    // NLL Borrow Checker MUST kill v1 and v2 here!
    *mut int m1 = &x;
    *m1 = 20;

    println(x); // Expected: 20
}

test_borrow_transitions();
println("--- [E2E] conditional_borrows.mox ---")

void test_cfg_borrows(bool cond) {
    int p = 10;

    if (cond) {
        *view int v1 = &p;
        int a = *v1;
        println(a); // Expected: 10
    } else {
        *view int v2 = &p;
        int b = *v2;
        println(b); // Expected: 10
    }

    // Both v1 and v2 have exited their respective lexical blocks.
    // It is now perfectly safe to mutate 'p'.
    *mut int m = &p;
    *m = 20;

    println(p); // Expected: 20
}

test_cfg_borrows(true);
test_cfg_borrows(false);
