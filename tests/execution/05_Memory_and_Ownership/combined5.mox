    }
}

ref class Derived(Base) {
    destructor() {
        println("Derived cleaned");
    }
}

void run_stress_test() {
    Resource<int> res = new Resource<int>(10);

    try {
        Derived d = new Derived();
        throw 1;
        // AST must support unwinding `d` and `res` here
    } catch (int e) {
        println("Caught exception");
    }
}

