println("--- [E2E] lifetime_scope_release.mox ---")

void test_lifetime_release() {
    int p = 100;

    // Scope 1: View borrow
    // Lexically alive until end of function, but NLL kills it after 'x' is assigned.
    *view int v = &p;
    int x = *v;
    println(x); // Expected: 100

    // Scope 2: Mut borrow
    // Perfectly safe because 'v' is dead.
    *mut int m = &p;
    *m = 200;
    println(p); // Expected: 200

    // Final: Mut borrow
    // Perfectly safe because the previous 'm' was popped successfully.
    *mut int m2 = &p;
    *m2 = 300;
    println(p); // Expected: 300
}

test_lifetime_release();
println("--- [E2E] loop_borrow_release.mox ---")

void test_loop_lifetimes() {
    int p = 10;

    while (p < 15) {
        // Safe: 'm' dies at the end of the block, so the next iteration
        // can safely take a new *mut borrow.
        *mut int m = &p;
        *m = *m + 1;
    }

    println(p); // Expected: 15

    // Safe: The loop is completely over, the block is popped.
    *mut int m2 = &p;
    *m2 = 30;

    println(p); // Expected: 30
}

test_loop_lifetimes();
println("--- [E2E] memory_qualifiers.mox ---")

void test_qualifiers() {
    // 1. Storage Declarations
    int base_val = 100;
    int mut_val = 200;
    lock int shared_data = 300;

    // 2. Pointers & References
    *mut int mut_ptr = &mut_val;
    &mut int mut_ref = mut_val;

    // Read-only views allow multiple aliases, so these are fine in the same scope!
    *view int view_ptr = &base_val;
    &view int view_ref = base_val;

    *lock int shared_ptr = &shared_data;
    int safely_copied_val;

    // 3. Lock Statement blocks
    lock (shared_ptr) {
        *shared_ptr = *shared_ptr + 1;
        safely_copied_val = *shared_ptr;
    }

    println(safely_copied_val); // Expected: 301
}

test_qualifiers();
