println("--- [E2E] pass_by_reference.mox ---")

// Pass by Value (Default)
void modifyValue(int val) {
    val = 100;
}

// Pass by Reference
void modifyRef(ref int ptr) {
    ptr = 100;
}

// Multiple Reference Parameters
void swap(ref int a, ref int b) {
    int temp = a;
    a = b;
    b = temp;
}

void test_references() {
    int x = 10;
    int y = 20;

    modifyValue(x);
    println(x); // Expected: 10 (unchanged)

    modifyRef(x);
    println(x); // Expected: 100 (changed)

    swap(x, y);
    println(x); // Expected: 20
    println(y); // Expected: 100
}

test_references();
println("--- [E2E] pointers.mox ---")

void test_pointers() {
    int val = 42;

    // 1. Address-Of Operator (&)
    // Yields a mutable pointer because the storage is mutable
    *mut int ptr = &val;

    // 2. Dereference Operator (*)
    // Safe to write because we hold the *mut capability
    unsafe {
        *ptr = 100;
        int read_val = *ptr;
        println(read_val); // Expected: 100
    }

    // 3. Pointer Arithmetic
    // Math on a *mut pointer yields another *mut pointer
    unsafe {
        *mut int next_ptr = ptr + 1;
        *mut int prev_ptr = next_ptr - 1;

        // 4. Pointer Difference
        isize diff = next_ptr - ptr;
        println(diff); // Expected: 1

        // Verify pointer math perfectly round-trips back to the original value
        println(*prev_ptr); // Expected: 100
    }
}

test_pointers();
println("--- [E2E] pointer_provenance.mox ---")

void test_pointer_math() {
    // 1. Allocate some legitimate memory to test with
    int target = 42;
    *mut int legitimate_ptr = &target;

    // 2. Cast pointer to an integer address (provenance stripping)
    usize phys_addr = cast<usize>(legitimate_ptr);

    // 3. Cast back to a pointer
    *view int ptr = cast<*view int>(phys_addr);

    // 4. Dereference the round-tripped pointer
    println(*ptr); // Expected: 42

    unsafe {
        // Unaligned Load/Store verification
        // Create an arbitrary address offset (simulating hardware memory-mapping)
        // We won't actually dereference it to avoid segfaulting on your OS,
        // but we verify the math works correctly.
        *mut unsigned int unaligned = cast<*mut unsigned int>(phys_addr + 1);

        usize new_addr = cast<usize>(unaligned);
        println(new_addr == phys_addr + 1); // Expected: true
    }
}

test_pointer_math();
println("--- [E2E] safety_and_types.mox ---")

// --- 1. Type Aliasing ---
// Verifies 'using' alias registration in the Symbol Table
using addr_t = usize;
using status_t = int;

// To make this safe for E2E execution without segfaulting,
// we will mock the VGA buffer address using a local variable's memory address.
unsigned int dummy_vga_buffer = 0_u32;
*mut unsigned int mock_ptr = &dummy_vga_buffer;
addr_t vga_buffer_addr = cast<usize>(mock_ptr);

void kernel_init() {
    // --- 2. Raw Pointers & Unsafe Blocks ---
    *mut unsigned int ptr = cast<*mut unsigned int>(vga_buffer_addr);

    unsafe {
        *ptr = 0x0F41_u32; // Legal inside unsafe block because ptr is *mut
    }

    println(dummy_vga_buffer); // Expected: 3905 (which is 0x0F41 in decimal)

    // --- 3. Mutability Model ---
    // Verifies aliasing rules for lock, mut, and view
    int counter = 0;

    // Correctly apply view to a reference/pointer, not a value
    *view int v = &counter;
    println(*v); // Expected: 0

    lock int static_val = 100;

    // Proves lock variables can only be mutated inside a synchronized block
    lock (&static_val) {
        static_val = 200;
    }
    println(static_val); // Expected: 200
}

kernel_init();
println("--- [E2E] scope_stress.mox ---")

int x = 100; // Global/Module scope

void run_scope_stress() {
    println(x); // Expected: 100

    // Testing top-level block scope shadowing
    {
        int x = 50; // Shadows global
        println(x); // Expected: 50

        {
            int x = 25; // Shadows local block
            println(x); // Expected: 25

            for (int x in [1, 2, 3]) { // Shadows outer block
                println(x);
                // Expected: 1
                // Expected: 2
                // Expected: 3

                closure(int) -> int clos = (int x) => { // Shadows loop variable
                    int x = 5; // Shadows lambda param
                    return x;
                };

                // Should completely ignore the passed 99 and the loop variable
                println(clos(99)); // Expected: 5
            }

            // Verifying the loop didn't permanently overwrite the block variable
            println(x); // Expected: 25
        }
        println(x); // Expected: 50
    }
    println(x); // Expected: 100
}

run_scope_stress();
println("--- [E2E] shadowing_borrows.mox ---")

void test_shadowing() {
    int p = 42;
    *view int v = &p;

    // Shadowing the variable name 'v' with another *view is perfectly fine
    // because multiple shared reads are allowed by the mutability matrix.
    // The previous 'v' becomes inaccessible lexically, but the borrow checker
    // safely tracks both until they naturally die.
    *view int v = &p;

    int x = *v;

    println(x); // Expected: 42
}

test_shadowing();
// ==========================================
// File: Valid\valid_aliasing_and_cycles.mox
// ==========================================

println("--- [E2E] valid_aliasing_and_cycles.mox ---")

// 1. SELF-REFERENTIAL STRUCTURE (Leak / Cycle Test)
// PASS (Runtime Check): Ensures the ARC system does not crash or infinite loop when a strong cycle exists.
// Note: This WILL leak memory unless explicitly broken, but it should compile and run without segfaulting.
ref class Node {
    public Node? self_ref;
    constructor() {}
}

void test_self_reference_cycle() {
    Node n = new Node();
    n.self_ref = n; // Strong reference cycle
    println("Cycle Created");
}

// 2. MUTATION THROUGH ALIAS CHAIN (Valid Deep Aliasing)
// PASS: Tracking multiple mutable pointers derived from the same source is valid
// as long as their usage doesn't violate active borrows.
void test_alias_chain_mutation() {
    int x = 10;
    *mut int p1 = &x;
    *mut int p2 = p1; // Aliasing

    *p1 = 20;
    *p2 = 30; // Valid: Reassigning via alias
    println(x); // Expected: 30
}

// 3. PARTIAL MOVES / SPLITTING
// PASS: Validates field-level disjointness analysis.
class SplitStruct { public int a; public int b; }

void test_partial_splitting() {
    SplitStruct s = new SplitStruct();
    s.a = 1;
    s.b = 2;

    int x = s.a; // Read from field A
    s.b = 3;     // Mutate field B
    println(x + s.b); // Expected: 4 (No conflict, fields are disjoint)
}

// --- Execution ---
test_self_reference_cycle();
test_alias_chain_mutation();
test_partial_splitting();
