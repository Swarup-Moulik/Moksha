println("--- [E2E] borrow_state_transitions.mox ---")

void test_borrow_transitions() {
    int x = 10;

    // View borrows are established
    *view int v1 = &x;
    *view int v2 = &x;
    int read_val = *v1 + *v2;
    println(read_val); // Expected: 20

    // Test: *mut is allowed because previous views are dead
    // NLL Borrow Checker MUST kill v1 and v2 here!
    *mut int m1 = &x;
    *m1 = 20;

    println(x); // Expected: 20
}

test_borrow_transitions();
