println("--- [E2E] nll_cfg_join.mox ---")

void test_join(bool cond) {
    int data = 100;

    if (cond) {
        *mut int m = &data;
        *m = 200;
        // NLL: 'm' dies here at the end of the true branch
    }

    // NLL: It is perfectly safe to borrow 'data' again because 'm'
    // did not survive the CFG join point!
    *mut int m2 = &data;
    *m2 = 300;

    println(data);
}

test_join(true);  // Expected: 300
test_join(false); // Expected: 300
