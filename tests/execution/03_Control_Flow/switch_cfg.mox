println("--- [E2E] switch_cfg.mox ---")

int test_switch(int val) {
    int result = 0;
    switch (val) {
        case 1:
            result = 10;
            break;
        case 2:
            result = 20;
            break;
        default:
            result = 30;
            break;
    }
    return result;
}

println(test_switch(2)); // Expected: 20
println(test_switch(5)); // Expected: 30
