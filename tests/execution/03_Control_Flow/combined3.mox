int test_diamond(bool cond) {
    int x = 0;

    // Standard CFG Branching (If-Else)
    if (cond) {
        x = 10;
    } else {
        x = 20;
    }

    // CFG Convergence (Phi Node)
    return x + 5;
}

println(test_diamond(true));  // Expected: 15
println(test_diamond(false)); // Expected: 25
println("--- [E2E] early_return_cfg.mox ---")

int test_return(bool abort) {
    int state = 0;

    if (abort) {
        state = 1;
        return state; // Branch straight to function epilogue
    }

    state = 2;
    return state;
}

println(test_return(true));  // Expected: 1
println(test_return(false)); // Expected: 2
println("--- [E2E] evaluation_order.mox ---")

int track(int val) {
    print(val + ", ");
    return val;
}

void consume(int a, int b, int c) {}
void consume_two(int a, int b) {}

// Must print 1, then 2, then 3 strictly.
// If it prints 3, 2, 1, the AST visitor is walking right-to-left.
consume(track(1), track(2), track(3));
println();

// Pipe evaluation order
// track(10) MUST evaluate before track(20) is evaluated
track(10) |> consume_two(track(20));
