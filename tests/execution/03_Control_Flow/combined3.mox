int test_switch(int val) {
    int result = 0;
    switch (val) {
        case 1:
            result = 10;
        case 2:
            result = 20;
        default:
            result = 30;
    }
    return result;
}

println(test_switch(2)); // Expected: 20
println(test_switch(5)); // Expected: 30
println("--- [E2E] switch_patterns.mox ---")

enum DeviceState { IDLE, BUSY, ERROR, DISCONNECTED }

void handle_device(DeviceState state) {
    // Verifies exhaustiveness checking and jump-tables
    switch (state) {
        case DeviceState.IDLE:
            println("Device is ready");

        case DeviceState.BUSY:
        case DeviceState.ERROR:
            // Verifies that empty cases fall through correctly
            println("Action required");

        case DeviceState.DISCONNECTED:
            println("Disconnected");
    }
}

handle_device(DeviceState.IDLE);  // Expected: Device is ready
handle_device(DeviceState.ERROR); // Expected: Action required
println("--- [E2E] ternary_and_cast.mox ---")

void test_ternary() {
    int x = 10;
    int y = 20;

    // Ternary Operator
    int max = (x > y) ? x : y;
    println(max); // Expected: 20

    // Nested Ternary
    string result = (x == y) ? "equal" : ((x > y) ? "greater" : "lesser");
    println(result); // Expected: lesser
}

void test_casting() {
    int x = 10;

    // Functional Casting Style
    double d = double(x);
    println(d); // Expected: 10

    // Template Casting Style
    int rounded = cast<int>(3.14);
    println(rounded); // Expected: 3
}

void test_null_coalescing() {
    string? name = null;
    string? validName = "Admin";

    println(name ?? "Guest");        // Expected: Guest
    println(validName ?? "Guest");   // Expected: Admin
}

test_ternary();
test_casting();
test_null_coalescing();
