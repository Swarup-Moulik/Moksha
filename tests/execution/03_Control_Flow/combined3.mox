void test_nested() {
    int i = 0;
    int total = 0;

    while (i < 3) {
        int j = 0;
        while (j < 2) {
            total = total + 1;
            j = j + 1;
        }
        i = i + 1;
    }

    println(total); // Expected: 6
}

test_nested();
