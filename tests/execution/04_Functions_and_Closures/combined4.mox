println("--- [E2E] function_boundaries.mox ---")

int read_data(*view int v) {
    return *v;
}

int test_function_calls() {
    int p = 50;

    *mut int m = &p;
    int a = read_data(m);

    // Passing a *view directly is now safe.
    *view int v = &p;
    int b = read_data(v);

    return a + b;
}

println(test_function_calls()); // Expected: 100
println("--- [E2E] higher_order_and_recursion.mox ---")

// 1. Passing a closure as an argument
int apply(int x, closure(int) -> int f) {
    return f(x);
}

// 2. Recursive closure
void test_recursion() {
    closure(int) -> int fact = (int n) => { return 0; };

    // Late-binding self-reference
    fact = &mut (int n) => {
        if (n <= 1) return 1;
        return n * fact(n - 1);
    };

    println(apply(5, fact)); // Expected: 120
}

test_recursion();
println("--- [E2E] higher_order_composition.mox ---")

// Multi-layer capture dependency
void test_nested_capture_layers() {
    int a = 10;
    closure() -> closure() -> int outer = () => {
        int b = 20;
        return () => {
            return a + b; // Captures 'a' from function, 'b' from outer lambda
        };
    };

    closure() -> int f = outer();
    println(f()); // Expected: 30
}

// Closure Composition [cite: 21]
closure(int) -> int compose(closure(int) -> int f) {
    return (int x) => {
        return f(x) + 1;
    };
}

void test_composition() {
    closure(int) -> int add2 = (int x) => { return x + 2; };
    closure(int) -> int result = compose(add2);
    println(result(5)); // Expected: 8
}

test_nested_capture_layers();
test_composition();
println("--- [E2E] large_env_stress.mox ---")

void test_large_env() {
    // Capturing a wide variety of types to stress the struct layout [cite: 13]
    int i1 = 1; double d1 = 1.1; bool b1 = true;
    int i2 = 2; double d2 = 2.2; string s1 = "stress";

    closure() -> void stress_f = move () => {
        println(s1);
        println(i1 + i2);
        println(d1 + d2);
    };

    closure() -> void stress_f2 = () => {
        println(s1);
        println(i1 + i2);
        println(d1 + d2);
    };

    closure() -> void stress_f3 = &() => {
        println(s1);
        println(i1 + i2);
        println(d1 + d2);
    };

    closure() -> void stress_f4 = &mut() => {
        println(s1);
        println(i1 + i2);
        println(d1 + d2);
    };

    stress_f();
    stress_f2();
    stress_f3();
    stress_f4();
}

test_large_env();
println("--- [E2E] method_overloading.mox ---")

class Printer {
    // Overload 1: Int
    void printData(int i) {
        println("Int: " + string(i));
    }

    // Overload 2: String
    void printData(string s) {
        println("String: " + s);
    }

    // Overload 3: Multiple Args (Arity overloading)
    void printData(string label, int val) {
        println(label + ": " + string(val));
    }
}

class Calculator {
    // Overload based on Return Type/Params implies different logic
    int add(int a, int b) {
        return a + b;
    }

    double add(double a, double b) {
        return a + b;
    }
}

// Execution
Printer p = new Printer();
p.printData(42);               // Expected: Int: 42
p.printData("Hello");          // Expected: String: Hello
p.printData("Score", 100);     // Expected: Score: 100

Calculator c = new Calculator();
int i = c.add(10, 20);
double d = c.add(10.5, 20.5);

println(i); // Expected: 30
println(d); // Expected: 31
println("--- [E2E] mutual_recursion.mox ---")

ref class NodeA {
    // Forward reference to NodeB
    public NodeB? next;
    public string name;
    constructor() { this.next = null; this.name = "NodeA"; }
}

ref class NodeB {
    // Backward reference to NodeA
    public NodeA? prev;
    public string name;
    constructor() { this.prev = null; this.name = "NodeB"; }
}

NodeA a = new NodeA();
NodeB b = new NodeB();

// Linking mutually recursive types
a.next = b;
b.prev = a;

println(a.next?.name ?? "null"); // Expected: NodeB
println(b.prev?.name ?? "null"); // Expected: NodeA
println("--- [E2E] operator_overloading.mox ---")

class Vector2 {
    public int x;
    public int y;

    constructor(int x, int y) {
        this.x = x;
        this.y = y;
    }

    // Binary Operator (+)
    Vector2 operator+(Vector2 other) {
        return new Vector2(this.x + other.x, this.y + other.y);
    }

    // Binary Operator (-)
    Vector2 operator-(Vector2 other) {
        return new Vector2(this.x - other.x, this.y - other.y);
    }

    // Equality Operator (==)
    bool operator==(Vector2 other) {
        return this.x == other.x && this.y == other.y;
    }

    // Unary Operator (-)
    Vector2 operator-() {
        return new Vector2(-this.x, -this.y);
    }
}

// Execution
Vector2 v1 = new Vector2(10, 20);
Vector2 v2 = new Vector2(5, 5);

// Should invoke operator+
Vector2 v3 = v1 + v2;
println(v3.x); // Expected: 15
println(v3.y); // Expected: 25

// Should invoke operator==
if (v3 == new Vector2(15, 25)) {
    println("Vector Math Works"); // Expected: Vector Math Works
}

// Should invoke unary operator-
Vector2 neg = -v1;
println(neg.x); // Expected: -10
println(neg.y); // Expected: -20
println("--- [E2E] pipe_closure_combo.mox ---")

void test_pipe_closure_capture() {
    int base = 5;
    // Closure syntax
    closure(int) -> int addBase = (int x) => {
        return x + base;
    };

    // Combinator: 10 passed to addBase(10)
    int res = 10 |> addBase();
    println(res); // Expected: 15
}

test_pipe_closure_capture();
