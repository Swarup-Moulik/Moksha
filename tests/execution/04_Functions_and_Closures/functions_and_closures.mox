println("--- [E2E] functions_and_closures.mox ---")

// Standard Function
int add(int a, int b) {
    return a + b;
}

// Lambda using the new closure type syntax
closure(int, int) -> int addFunc = (int b, int c) => {
    return b + c;
}

println(add(10, 20));       // Expected: 30
println(addFunc(50, 50));   // Expected: 100
