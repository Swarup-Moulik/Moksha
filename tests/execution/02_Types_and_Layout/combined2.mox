println("--- [E2E] cyclic_module_a.mox (Cyclic Imports) ---")

from "cyclic_module_b" import { ClassB }

public class ClassA {
    public ClassB? bRef;

    constructor() {
        this.bRef = null;
    }

    public string getName() {
        return "I am ClassA";
    }
}

// Instantiate both to prove the types were resolved
ClassA a = new ClassA();
ClassB b = new ClassB();

// Create a cyclic memory graph!
a.bRef = b;
b.aRef = a;

println(a.getName());                 // Expected: I am ClassA
println(a.bRef?.getName() ?? "null"); // Expected: I am ClassB
println(b.aRef?.getName() ?? "null"); // Expected: I am ClassA
from "cyclic_module_a" import { ClassA }

public class ClassB {
    public ClassA? aRef;

    constructor() {
        this.aRef = null;
    }

    public string getName() {
        return "I am ClassB";
    }
}
println("--- [E2E] deep_generic_nesting.mox ---")

generic Map<K, V> {
    public K key;
    public V val;
    constructor(K k, V v) { this.key = k; this.val = v; }
}

generic List<T> {
    public T item;
    constructor(T i) { this.item = i; }
}

// 1. Parser and Typechecker must handle deep nesting
Map<string, List<Map<int, string>>> deeplyNested =
    new Map<string, List<Map<int, string>>>(
        "root",
        new List<Map<int, string>>(new Map<int, string>(16, "leaf"))
    );

println(deeplyNested.key);             // Expected: root
println(deeplyNested.val.item.val);    // Expected: leaf

// 2. Parser must differentiate right-shift `>>` from generic closures `>>`
int targetValue = deeplyNested.val.item.key; // 16
int shiftResult = targetValue >> 2;          // 16 >> 2 = 4

println(shiftResult); // Expected: 4
