// ---------------------------------------------------------
// 1. Evaluation Order & Side Effects
// ---------------------------------------------------------
int global_state = 0;

int track(int val) {
    global_state += val;
    println(`Evaluated: ${val}`);
    return val;
}

// Tests left-to-right evaluation vs precedence binding
int eval_result = track(1) + track(2) * track(3);
println(`State after eval: ${global_state}`); // Expected: 6

// ---------------------------------------------------------
// 2. Short-Circuit Semantics
// ---------------------------------------------------------
bool panic_if_called() {
    println("FAIL: Short-circuit did not work!");
    return true;
}

bool sc1 = false && panic_if_called(); // MUST NOT print
bool sc2 = true || panic_if_called();  // MUST NOT print
println("Short-circuit tests passed if no FAIL printed above.");

// ---------------------------------------------------------
// 3. Associativity Edge Cases
// ---------------------------------------------------------
int assoc_div = 100 / 10 / 2; // Expected: 5 (Left-associative)
int assoc_pow = 2 ** 3 ** 2;  // Usually 512 (Right) or 64 (Left) - verifies your compiler's choice

// Nested Ternary (Right-associative check)
int nested_ternary = true ? false ? 1 : 2 : 3;
println(nested_ternary); // Expected: 2

