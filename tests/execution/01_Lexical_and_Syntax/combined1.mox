// 4. Deep Nullable & Pipeline Chaining
// ---------------------------------------------------------
ref class Node {
    public int[] values;
    public Node? next;
    constructor() {
        this.values = [10, 20];
        this.next = null;
    }
}

Node? root = null;
// Must safely abort the chain and fallback to 42 without panicking
int safe_extract = root?.next?.values?[0] ?? 42;
println(safe_extract); // Expected: 42

// Pipeline chaining depth
int add_one(int x) { return x + 1; }
println(10 |> add_one |> add_one |> add_one); // Expected: 13

