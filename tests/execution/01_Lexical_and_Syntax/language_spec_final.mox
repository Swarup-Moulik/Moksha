int global_state = 0;
println("--- [E2E] language_spec_final.mox ---");

// ---------------------------------------------------------
// 1. Discriminative Pipeline Precedence
// ---------------------------------------------------------
// Separates (1+2)|>f [yields 30] from 1+(2|>f) [yields 21]
int multiply_ten(int x) { return x * 10; }
int pipe_test = 1 + 2 |> multiply_ten();
println(`Pipeline Strict (Expected 30): ${pipe_test}`);

// ---------------------------------------------------------
// 2. Increment Decomposition (Strict LTR Guarantee)
// ---------------------------------------------------------
int x = 5;
int a = x++; // a gets 5, x becomes 6
int b = ++x; // x becomes 7, b gets 7
println(`Increment a (Expected 5): ${a}`);
println(`Increment b (Expected 7): ${b}`);

// ---------------------------------------------------------
// 3 & 4. Decimal vs Float Spec Laws
// ---------------------------------------------------------
decimal<5,2> d = 1.23d;
float f = 1.23;
// Law: Float promotes to Decimal for math, but direct equality is strictly false due to base-2 vs base-10 exactness limits.
// println(`Decimal == Float (Expected false): ${d == f}`);
println(`Decimal + Float (Expected 2.46): ${d + f}`);

// ---------------------------------------------------------
// 5 & 9. Lazy Evaluation Contracts (?? and Ternary)
// ---------------------------------------------------------
int panic_side_effect() {
    println("FATAL: Lazy evaluation failed!");
    return 999;
}

int? safe_null = 10;
// These MUST short-circuit. If "FATAL" prints, the IR lowering is broken.
int coalesce_val = safe_null ?? panic_side_effect();
int ternary_val = true ? 42 : panic_side_effect();
println("Lazy evaluation passed if no FATAL prints above.");

// ---------------------------------------------------------
// 6. Array Aliasing Semantics
// ---------------------------------------------------------
int[] arr1 = [1, 2, 3];
int[] arr2 = arr1;
arr2[0] = 99;
println(`Array Aliasing (Expected 99): ${arr1[0]}`);

// ---------------------------------------------------------
// 7. Function Argument Evaluation Order
// ---------------------------------------------------------
int step(int val) {
    global_state = global_state * 10 + val;
    return val;
}
int dummy_add(int x, int y) { return x + y; }

dummy_add(step(1), step(2));
// Law: Arguments evaluate strictly Left-to-Right.
println(`Arg Eval Order (Expected 12): ${global_state}`);

// ---------------------------------------------------------
// 8 & 10. Logical Types & Machine-Level Shifts
// ---------------------------------------------------------
// Moksha requires strict bools, no truthy/falsy integers allowed in logical ops.
bool strict_logic = true && false;
println(`Strict Logic Return (Expected false): ${strict_logic}`);

// Shift bounds mapping to hardware
int shift_base = 1;
println(`Shift 31 (Expected -2147483648): ${shift_base << 31}`);
// println(`Shift 32 (Expected 0 OR Unchanged): ${shift_base << 32}`);
