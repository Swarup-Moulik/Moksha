println("--- [E2E] async_synchronization.mox ---")

async void test_async_mutex() {
    println("Main: Starting async mutex test...");

    // AsyncMutex yields the coroutine instead of blocking the OS thread
    AsyncMutex mtx = new AsyncMutex();
    int shared_resource = 0;

    println("Main: Spawning task t1...");
    promise<void> t1 = spawn(async () => {
        println("  [t1] Attempting to acquire lock...");
        async lock(mtx) {
            println("  [t1] Lock acquired! Incrementing resource by 1...");
            shared_resource = shared_resource + 1;

            println("  [t1] Resource is now " + shared_resource + ". Suspending for 10ms...");
            await sleep(10); // Perfectly safe to suspend while holding an AsyncMutex

            println("  [t1] Woke up. Releasing lock...");
        } // mtx.unlock() is automatically called here
        println("  [t1] Task complete.");
    });

    println("Main: Spawning task t2...");
    promise<void> t2 = spawn(async () => {
        println("  [t2] Attempting to acquire lock...");
        async lock(mtx) { // Suspends until t1 finishes its async block
            println("  [t2] Lock acquired! Incrementing resource by 2...");
            shared_resource = shared_resource + 2;

            println("  [t2] Resource is now " + shared_resource + ". Releasing lock...");
        } // mtx.unlock() is automatically called here
        println("  [t2] Task complete.");
    });

    println("Main: Awaiting both tasks to join...");
    await join(t1, t2);

    println("Main: Tasks joined successfully.");
    println("Final shared_resource: " + shared_resource); // Expected: 3
}

await test_async_mutex()
println("--- [E2E] atomics.mox ---")

void test_atomics_full() {
    unsigned int data = 0_u32;
    *mut unsigned int ptr = &data;

    // Verifies built-in function resolution and type compatibility
    atomic_store(ptr, 100_u32);
    unsigned int val = atomic_load(ptr);
    println(val); // Expected: 100

    // Testing old value return semantics
    unsigned int old = atomic_add(ptr, 10_u32);
    println(old); // Expected: 100
    println(atomic_load(ptr)); // Expected: 110

    // Testing Compare-and-Swap (CAS)
    unsigned int current = atomic_cas(ptr, 110_u32, 200_u32);
    println(current); // Expected: 110
    println(atomic_load(ptr)); // Expected: 200

    // Memory Fences (Lowered to LLVM fences in backend)
    atomic_fence_acquire();
    atomic_fence_release();
    atomic_fence_seqcst();

    println("Fences successfully emitted"); // Expected: Fences successfully emitted
}

test_atomics_full();
println("--- [E2E] atomic_ordering.mox ---")

void test_atomics() {
    int counter = 0;
    *mut int ptr = &counter;

    // The MIR lowerer MUST translate this into a hardware-level atomic Add,
    // not a Load -> Add -> Store sequence!
    atomic_add(ptr, 1);
    println(counter); // Expected: 1

    int expected = 1;
    int desired = 5;

    // Compare-and-swap must retain the exact memory ordering requested
    // so the LLVM backend can emit the correct memory barrier fences.
    int old = atomic_cas(ptr, expected, desired);

    println(old);     // Expected: 1
    println(counter); // Expected: 5
}

test_atomics();
