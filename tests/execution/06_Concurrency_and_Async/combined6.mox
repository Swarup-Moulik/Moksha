// 2. ATOMIC CONTENTION (Hardware Memory Model Stress)
async void test_atomic_contention() {
    int shared_val = 0;
    *mut int p = &shared_val;

    // We spawn 50 OS threads using 'new thread'.
    // Since we aren't using an array to 'join', we use a sleep buffer.
    for (int i = 0; i < 50; i = i + 1) {
        new thread(() => {
            for (int j = 0; j < 1000; j = j + 1) {
                atomic_add(p, 1);
            }
        });
    }

    // Give hardware threads time to finish their loops
    await sleep(500);

    // If the atomic lowering is correct, this will be exactly 50000
    println(shared_val); // EXPECTED: 50000
}

