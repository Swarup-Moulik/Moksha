// 1. ASYNC SCOPES (The Tokio/Swift Model)
async void test_task_group() {
    int completed_tasks = 0;

    // async_scope blocks until all spawned children complete or are cancelled
    await async_scope((TaskGroup group) => {
        group.spawn(async () => { await sleep(10); completed_tasks = completed_tasks + 1; });
        group.spawn(async () => { await sleep(20); completed_tasks = completed_tasks + 1; });
    });

    // Both tasks are guaranteed to be finished when the scope exits
    println(completed_tasks); // Expected: 2
}

// 2. FAIL-FAST CANCELLATION CASCADE
async void test_join_cancellation_cascade() {
    promise<int> a = spawn(async () => {
        throw new Exception("Task A Failed");
    });

    promise<int> b = spawn(async () => {
        await sleep(500); // Long running task
        return 1;
    });

    try {
        await join(a, b);
    } catch (Exception e) {
        println("Join aborted early"); // Expected: Join aborted early
    }

    // RED TEAM: Because 'a' failed, 'join' must explicitly send a cancel signal to 'b'.
    // If 'b' is still running, you have a resource leak!
    println(b.is_cancelled()); // Expected: true
}

await test_task_group()
await test_join_cancellation_cascade()
println("--- [E2E] tls_storage.mox ---")

// Verifies TLS initialization duration and linking
static thread_local int cpu_id = 0;
static thread_local int[10] kernel_gs_base;

void init_per_cpu(int id) {
    cpu_id = id; // Verifies local assignment to TLS variable
    kernel_gs_base[0] = id;

    println(cpu_id);            // Expected: 42
    println(kernel_gs_base[0]); // Expected: 42
}

void run_tls_test() {
    init_per_cpu(42);

    // Spawn a thread to prove the thread-local variables start fresh
    new thread(() => {
        println(cpu_id);            // Expected: 0
        println(kernel_gs_base[0]); // Expected: 0
    });
}

run_tls_test();
