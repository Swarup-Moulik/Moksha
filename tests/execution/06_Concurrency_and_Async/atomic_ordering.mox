println("--- [E2E] atomic_ordering.mox ---")

void test_atomics() {
    int counter = 0;
    *mut int ptr = &counter;

    // The MIR lowerer MUST translate this into a hardware-level atomic Add,
    // not a Load -> Add -> Store sequence!
    atomic_add(ptr, 1);
    println(counter); // Expected: 1

    int expected = 1;
    int desired = 5;

    // Compare-and-swap must retain the exact memory ordering requested
    // so the LLVM backend can emit the correct memory barrier fences.
    int old = atomic_cas(ptr, expected, desired);

    println(old);     // Expected: 1
    println(counter); // Expected: 5
}

test_atomics();
