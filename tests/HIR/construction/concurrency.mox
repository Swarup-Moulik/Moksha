// Weak Async Function
weak async string fetchData() {
    return "Data"
}

// Async Function
async string fetchData2() {
    return "Data"
}

void test_concurrency() {
    // Weak Thread creation
    new weak thread(() => {
        print("Background task")
    })

    // Strong Thread creation
    new thread(() => {
        print("Foreground task")
    })

    // Await usage
    string data = await fetchData()
}
