void test_exception_unwind() {
    mut int p = 100

    try {
        *view int v = &p
        if (p == 100) {
            throw 1
        }
        // 'v' is destroyed during the unwind
    } catch (int e) {
        // Safe! The 'try' scope was popped, so 'p' is Unborrowed.
        *mut int m = &p
        *m = 200
    }
}
