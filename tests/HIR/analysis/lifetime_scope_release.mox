void test_lifetime_release() {
    mut int p = 100

    // Scope 1: View borrow
    {
        *view int v = &p
        int x = *v
    } // 'v' goes out of scope here. 'p' is fully released.

    // Scope 2: Mut borrow
    {
        *mut int m = &p
        *m = 200
    } // 'm' goes out of scope here. 'p' is fully released again.

    // Final: Mut borrow to prove the previous 'm' was popped successfully
    *mut int m2 = &p
    *m2 = 300
}
