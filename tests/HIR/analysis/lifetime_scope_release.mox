void test_lifetime_release() {
    int p = 100;

    // Scope 1: View borrow
    // Lexically alive until end of function, but NLL kills it after 'x' is assigned.
    *view int v = &p;
    int x = *v;

    // Scope 2: Mut borrow
    // Perfectly safe because 'v' is dead.
    *mut int m = &p;
    *m = 200;

    // Final: Mut borrow
    // Perfectly safe because the previous 'm' was popped successfully.
    *mut int m2 = &p;
    *m2 = 300;
}
