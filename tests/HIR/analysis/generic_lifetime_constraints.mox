// A generic class that explicitly requires ARC-managed (shared) or owned types
generic Container<shared T> {
    T item;
}

// A standard reference class to test heap-allocated sharing
class User {
    string name;
}

void test_generics() {
    // VALID: Passing a standard value type (owned, not borrowed)
    Container<int> c1 = new Container<int>();
    c1.item = 42;

    // VALID: Passing a standard reference type (string is ARC-managed by default)
    Container<string> c2 = new Container<string>();
    c2.item = "Moksha Compiler";

    // VALID: Passing a custom user-defined class
    Container<User> c3 = new Container<User>();
    c3.item = new User();
    c3.item.name = "Alice";
}
