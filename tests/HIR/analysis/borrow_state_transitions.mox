void test_borrow_transitions() {
    mut int x = 10

    // Test: Multiple *view pointers can coexist
    {
        *view int v1 = &x
        *view int v2 = &x
        int read_val = *v1 + *v2
    } // v1 and v2 lifetimes end here. 'x' is now Unborrowed.

    // Test: *mut is allowed because previous views are dead
    *mut int m1 = &x
    *m1 = 20
}
