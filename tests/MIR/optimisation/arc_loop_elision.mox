ref class Node {
        // No custom drop() method, so ARCAnalyzer is allowed to elide pure pairs!
    }

    void test_loop_elision() {
        Node s = new Node();
        int i = 0;

        while (i < 1000) {
            // The Inserter will naively put a Retain/Release here.
            // The Analyzer MUST delete them because 'copy' never escapes the loop
            // and Node has no custom drop() side-effects!
            Node copy = s;
            i = i + 1;
        }
    }
