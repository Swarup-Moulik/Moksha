void test_atomics() {
    int counter = 0;
    *mut int ptr = &counter;

    // The MIR lowerer MUST translate this into a hardware-level atomic Add,
    // not a Load -> Add -> Store sequence!
    atomic_add(ptr, 1);

    int expected = 0;
    int desired = 5;

    // Compare-and-swap must retain the exact memory ordering requested
    // so the LLVM backend can emit the correct memory barrier fences.
    atomic_cas(ptr, expected, desired);
}
