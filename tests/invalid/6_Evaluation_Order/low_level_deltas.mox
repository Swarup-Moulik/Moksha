    // ERROR: Invalid success/failure ordering combination
    atomic_cas(&x, 0, 1, "relaxed", "seq_cst");

    // ERROR: Misaligned atomic access
    align(1) i64 unaligned_val = 0; // [FIX] Initialize it!
    atomic_load(&unaligned_val, "seq_cst");
}

