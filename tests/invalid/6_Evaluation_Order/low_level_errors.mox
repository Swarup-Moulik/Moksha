struct BadHardware {
    // Verifies bitfield overflow check
    unsigned char too_wide : 12; // ERROR: Bitfield width 12 exceeds max width of type 'u8' (8 bits)

    // Verifies type restriction
    float illegal_bit : 1;       // ERROR: Bitfields must have an integer type
}

void test_unsafe() {
    unsigned int* ptr = cast<unsigned int*>(0x1000);
    // Verifies safety barrier
    *ptr = 42; // ERROR: Raw pointer dereference requires 'unsafe' block
}
