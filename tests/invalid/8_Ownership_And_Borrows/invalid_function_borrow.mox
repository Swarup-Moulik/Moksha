void mutate_data(*mut int m) {
    *m = 100
}

void test_invalid_function_call() {
    int p = 50
    *view int v = &p

    // Attempting to pass a read-only view to a mutable parameter
    // mutate_data(v) // ERROR EXPECTED

    // Attempting to create a temporary *mut borrow for the function call
    // while a *view ('v') is still active in the current scope
    mutate_data(&p) // ERROR EXPECTED
    print(*v);
}
