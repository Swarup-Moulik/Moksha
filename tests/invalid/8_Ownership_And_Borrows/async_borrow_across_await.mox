async int fetch_data() {
    return 99;
}

async void test_async_borrow() {
    int local_data = 42;
    *mut int ptr = &local_data;

    // ERROR EXPECTED: Cannot hold a mutable borrow across an `await` suspension point.
    // The underlying memory might be moved or invalidated when the coroutine suspends!
    int result = await fetch_data();

    // The safe world thinks ptr is still valid here.
    *ptr = result;
}
