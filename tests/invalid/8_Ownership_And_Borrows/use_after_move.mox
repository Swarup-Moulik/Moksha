void test_move() {
        string s1 = "Hello";

        // Move semantics: 's1' ownership is transferred to 's2'
        string s2 = s1;

        // ERROR EXPECTED: Use of moved value. 's1' is no longer valid!
        string s3 = s1;
    }

    closure() -> void test_closure_escape() {
        int scoped_val = 42;

        // ERROR EXPECTED: closure captures local 'scoped_val' and escapes!
        // The heap-allocated closure tries to store a pointer to the local stack frame.
        return () => {
            mut int* ptr = &scoped_val;
        };
    }
