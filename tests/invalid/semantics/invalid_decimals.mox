// ==========================================
// TEST: Invalid Decimal Operations (Errors)
// ==========================================

void test_fractional_truncation() {
    decimal<5, 3> precise_val; // e.g., 99.999
    decimal<5, 2> rounded_val;

    // EXPECT ERROR: Cannot assign decimal with scale 3 to scale 2 (would truncate).
    rounded_val = precise_val;
}

void test_whole_number_overflow() {
    decimal<6, 2> large_val;   // 4 whole digits (e.g., 9999.99)
    decimal<5, 2> small_val;   // 3 whole digits (e.g., 999.99)

    // EXPECT ERROR: Target supports 3 whole digits, but expression requires up to 4.
    small_val = large_val;
}

void test_invisible_math_overflow() {
    decimal<5, 2> a;
    decimal<5, 2> b;

    // Math: a + b evaluates to decimal<6, 2> to account for the carry bit (999.99 + 0.01 = 1000.00).
    // EXPECT ERROR: Target supports 3 whole digits, but expression requires up to 4.
    decimal<5, 2> c = a + b;
}

void test_invisible_multiplication_overflow() {
    decimal<4, 2> a; // e.g. 99.99
    decimal<4, 2> b; // e.g. 99.99

    // Math: a * b evaluates to decimal<8, 4>.
    // EXPECT ERROR: Target supports 3 whole digits, but expression requires up to 4.
    decimal<7, 4> c = a * b;
}

void test_type_mismatches() {
    decimal<5, 2> a;
    string s = "100.00";

    // EXPECT ERROR: Cannot assign type string to decimal<5, 2>
    a = s;
}
