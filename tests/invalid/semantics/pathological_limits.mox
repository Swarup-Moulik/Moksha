// Generic Infinite Expansion
// A naive TypeChecker will try to resolve Foo<Foo<Foo<...>>> forever.
generic Foo<T> {
    Foo<Foo<T>> next;
}

// Compile-Time Evaluation Loop (if applicable)
int infinite_loop() {
    while(true) {}
    return 0;
}

void test_limits() {
    // ERROR EXPECTED: Compiler should halt with "Recursion Depth Exceeded"
    // instead of crashing with a Stack Overflow (ICE).
    Foo<int>? explosive_type = null;

    // ERROR EXPECTED: "CTFE execution step limit exceeded"
    int[infinite_loop()] arr; // (Uncomment if your language supports CTFE)
}
