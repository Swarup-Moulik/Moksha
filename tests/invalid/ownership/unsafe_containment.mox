int immutable_val = 100
*mut int leaked_mut = null

unsafe {
    // OK: Inside unsafe, we can force a cast from immutable to mutable
    *mut int raw_ptr = cast<*mut int>(&immutable_val)
    *raw_ptr = 200

    // Attempting to leak the illegal capability out of the block
    leaked_mut = raw_ptr
}

// ERROR EXPECTED: The safe world cannot use `leaked_mut` because its provenance
// traces back to immutable storage. Unsafe capabilities cannot escape the block.
*leaked_mut = 300
