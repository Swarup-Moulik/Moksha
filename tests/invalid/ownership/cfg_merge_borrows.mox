void test_cfg_merging(bool condition, bool condition2) {
    int data = 42
    *mut int p_mut = null
    *view int p_view = null

    bool condition = true

    if (condition) {
        p_mut = &data
    } else {
        p_view = &data
    }

    // ERROR EXPECTED HERE: The compiler must union the branches.
    *mut int illegal_alias = &data

    int x = 10
    int y = 20
    *mut int ptr = &x

    if (false) {
        ptr = &y
    }

    // ERROR EXPECTED HERE: ptr MIGHT still point to x.
    *mut int alias_x = &x

    print(illegal_alias)
    print(alias_x)
    print(ptr)
    print(p_mut)
}
