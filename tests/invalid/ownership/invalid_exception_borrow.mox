void test_exception_leak() {
    mut int p = 100
    *view int outer_view = &p // Lives for the whole function

    try {
        throw 1
    } catch (int e) {
        // ERROR: The unwind destroyed the 'try' scope,
        // but 'outer_view' is still alive in the parent scope!
        *mut int m = &p
    }
}
