void test_invalid_shadowing() {
    int p = 42;
    *view int v = &p;

    // Alias the first 'v' so we can keep its loan alive even after shadowing
    *view int keep_alive = v;

    // Shadowing the identifier 'v', but attempting an illegal *mut borrow on 'p'.
    *mut int v = &p; // ERROR EXPECTED

    // -> Keeps the original *view borrow on 'p' alive down to here!
    int read = *keep_alive;
}
