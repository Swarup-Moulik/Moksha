generic Box<T> {
    public T val;
    constructor(T v) { this.val = v; }
}

// Nested Generics Torture
Box<Box<int>> nested = new Box<Box<int>>(new Box<int>(10));

// ERROR: Conflicting specializations.
// Cannot implicitly cast Box<int> to Box<any> if generics are invariant.
Box<any> invalidCast = new Box<int>(5);
