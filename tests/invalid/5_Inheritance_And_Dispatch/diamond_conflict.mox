class Logger {
    void log() { print("Logger default"); }
}

class Monitor {
    void log() { print("Monitor default"); }
}

// FATAL: Ambiguous implementation.
// Class 'System' implements both Logger and Monitor, which both provide 'log()'.
// The compiler must force 'System' to override 'log()' to resolve the ambiguity.
class System(Logger, Monitor) {
    public int id;
    constructor(int id) { this.id = id; }
}

System sys = new System(1);
sys.log();

class A { void log(int x) {} }
class B { void log(string s) {} }
class C(A, B) {}
