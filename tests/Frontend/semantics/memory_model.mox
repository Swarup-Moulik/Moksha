// --- 1. Full Ordering Matrix & RMW Ops ---
void test_ordering_matrix(*mut int ptr, int val) {
    int a = atomic_add(ptr, val);
    int b = atomic_load(ptr);
    int c = atomic_load(ptr);
    atomic_store(ptr, val);
    int d = atomic_load(ptr);
}

// --- 2. Strong CAS & Failure Ordering ---
void test_cas_semantics(*mut int ptr, int expected, int desired) {
    int success = atomic_cas(ptr, expected, desired);
    int res = atomic_cas(ptr, expected, desired);
}

// --- 3. Fence + Load/Store Interaction ---
void test_fence_interaction(*mut int data, *mut int flag) {
    *data = 42;
    atomic_thread_fence("release");
    atomic_store(flag, 1);

    if (atomic_load(flag) == 1) {
        atomic_thread_fence("acquire");
        int val = *data;
    }
}

// --- 4. Size & Alignment Validation ---
struct AtomicData {
    align(8) long val;
}

void test_alignment() {
    mut AtomicData d; // FIX: Struct must be mutable to mutate its fields
    d.val = 0_i64;

    // Safe because d is mut
    atomic_store(&d.val, 100_i64);
}
