class Tracer {
    public int id;
    constructor(int id) {
        this.id = id;
        print(`Created ${this.id}`);
    }
    destructor() {
        print(`Destroyed ${this.id}`);
    }
}

try {
    Tracer t1 = new Tracer(1);
    Tracer t2 = new Tracer(2);
    Tracer t3 = new Tracer(3);

    // Exception thrown!
    // The AST must generate cleanup blocks that print:
    // Destroyed 3
    // Destroyed 2
    // Destroyed 1
    throw "Fatal Error";

} catch (any e) {
    print("Caught exception");
}
