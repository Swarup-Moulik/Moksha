void test_atomics(*mut unsigned int ptr) {
    // Verifies built-in function resolution and type compatibility
    atomic_store(ptr, 100_u32);
    unsigned int val = atomic_load(ptr);

    // Testing old value return semantics
    unsigned int old = atomic_add(ptr, 10_u32);

    // Testing Compare-and-Swap (CAS)
    unsigned int current = atomic_cas(ptr, 100_u32, 200_u32);

    // Memory Fences (Lowered to LLVM fences in backend)
    atomic_fence_acquire();
    atomic_fence_release();
    atomic_fence_seqcst();
}
