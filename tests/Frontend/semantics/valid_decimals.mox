// ==========================================
// TEST: Valid Decimal Operations & Scaling
// ==========================================

// 1. Basic Widening (Assignment)
// We use parameters to guarantee the variables are initialized!
void test_safe_assignments(decimal<5, 2> small_amount) {

    // SAFE: decimal<9, 2> has more whole digits (7) than decimal<5, 2> (3).
    decimal<9, 2> account_balance = small_amount;

    // SAFE: decimal<10, 4> has more scale AND more whole digits.
    decimal<10, 4> highly_precise = small_amount;
}

// 2. Mathematical Scaling
void test_safe_math(decimal<5, 2> a, decimal<4, 1> b) {

    // ADDITION: Max scale is 2. Max whole is 3. Carry bit adds 1.
    // Result type: decimal<6, 2>.
    // SAFE: Assigning to decimal<6, 2> fits perfectly.
    decimal<6, 2> sum = a + b;

    // SUBTRACTION: Same rule as addition. Result: decimal<6, 2>.
    decimal<6, 2> diff = a - b;

    // MULTIPLICATION: Sum of scales (2+1=3), Sum of precisions (5+4=9).
    // Result type: decimal<9, 3>.
    decimal<9, 3> product = a * b;

    // DIVISION: Max scale (6), Whole digits (5-2)+1 = 4.
    // Result type: decimal<10, 6>.
    decimal<10, 6> quotient = a / b;
}

// 3. Functions and Generics
decimal<9, 2> process_transaction(decimal<5, 2> amount) {
    // SAFE: Widening the return type from 5,2 to 9,2
    return amount;
}

void test_complex_types() {
    // Arrays of decimals
    decimal<7, 2>[] ledger;

    // Pointers to decimals
    *mut decimal<9, 2> balance_ptr;
}
