// --- 1. OS-Level Macros ---
// Verifies that MacroSubstituter can clone 'asm' and 'sizeof' nodes
macro DISABLE_INTERRUPTS() {
    asm("cli");
}

macro GET_SIZE(obj) {
    sizeof(obj)
}

void process_data(unsigned int data) {
    // --- 2. Bit Manipulation Intrinsics ---
    // Verifies registration of low-level built-ins
    unsigned int reversed = bswap32(data);
    int leading_zeros = clz(data);

    // --- 3. SizeOf Expression ---
    // Verifies 'sizeof' evaluates to 'usize'
    usize data_size = sizeof(data);

    DISABLE_INTERRUPTS();
}
