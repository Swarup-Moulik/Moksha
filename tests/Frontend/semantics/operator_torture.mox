int add(int a, int b) { return a + b; }
int multiply(int a, int b) { return a * b; }
int process(int x) { return x; }
int transform(int v) { return v * 2; }
bool check(int v) { return v > 0; }

int a = 10;
int b = 20;
int c = 2;
int d = 5;
int dynamicVal = 42;
int? nullableVal = null;
bool x = true;
bool y = false;
bool z = true;

(a + b |> process()) * c;

true ? b : (c |> process()) + d;

a = b |> process();

nullableVal ?? 100 |> process();

bool result1 = (a + b * c |> transform()) ? x : y && z;

bool result2 = (int(dynamicVal) |> transform()) ?? 100 >= 50;
