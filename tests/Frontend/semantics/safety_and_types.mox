// --- 1. Type Aliasing ---
// Verifies 'using' alias registration in the Symbol Table
using addr_t = usize;
using status_t = int;

addr_t vga_buffer = 0xB8000_usize;

void kernel_init() {
    // --- 2. Raw Pointers & Unsafe Blocks ---
    // [FIX] Changed to *mut to allow dereference mutation below
    *mut unsigned int ptr = cast<*mut unsigned int>(vga_buffer);

    unsafe {
        *ptr = 0x0F41_u32; // Legal inside unsafe block because ptr is *mut
    }

    // --- 3. Mutability Model ---
    // Verifies aliasing rules for lock, mut, and view
    mut int counter = 0;

    // [FIX] 'view' must be applied to a reference or pointer, not a value
    view int v = counter;

    // Negative Test: Should trigger err_type_mismatch (Cannot mutate through view)
    // v = 10;

    lock int static_val = 100;
    // Negative Test: Should trigger err_type_mismatch (Cannot mutate lock without lock block)
    // static_val = 200;
}
