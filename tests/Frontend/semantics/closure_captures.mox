void test_snapshot_capture() {
    int a = 10;

    // 1. Snapshot Capture (Default by-value copy)
    closure() -> int snap = () => {
        return a + 5;
    }

    // Valid: We can mutate 'a' outside because the closure has its own copy
    a = 20;
}

void test_view_capture() {
    int b = 100;

    // 2. View Capture (Immutable Borrow)
    closure() -> int view_closure = &() => {
        return b;
    }

    // Valid: We can still read 'b' outside because 'view_closure' only took a shared borrow
    int temp = b;
}

void test_mut_capture() {
    int c = 50;

    // 3. Mut Capture (Mutable Borrow)
    closure() -> void mut_closure = &mut () => {
        c = c + 10;
    }

    // Valid: The closure modifies the outer 'c'
    mut_closure();
}

void test_move_capture() {
    string d = "Hello Moksha";

    // 4. Move Capture (Ownership Transfer)
    // d is an owned string, so it moves into the closure's environment
    closure() -> string move_closure = move () => {
        return d;
    }

    // 'move_closure' now fully owns the string memory.
}

test_snapshot_capture();
test_view_capture();
test_mut_capture();
test_move_capture();
