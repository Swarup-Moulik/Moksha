// --- Naked Stub (Bootloaders/Syscalls) ---
// Verifies 'naked' attribute (no prologue/epilogue generated by backend)
naked void bootstrap_entry() {
    asm("mov %rax, %rsp");
    asm("jmp kernel_main");
}
