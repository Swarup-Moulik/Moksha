int processInt(int x) { return x; }
any processAny(any x) { return x; }

any dynamicVal = 42;

// 1. Functional Cast
int(dynamicVal) |> processInt();

// 2. Piping directly into a functional cast!
// This works perfectly because int() is treated as a function call!
print(10 |> processAny() |> int());

// 3. Precedence collision solved by grouping parentheses
dynamicVal = (int(dynamicVal) + 5) |> processInt();
