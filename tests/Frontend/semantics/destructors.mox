// 1. Define global mock IO
class IO {
    public any open(string path, string mode) { return null; }
}

// Renamed to avoid colliding with Moksha's built-in 'close'
void mockClose(any handle) {}

// 2. This is now a true Global Variable
IO io = new IO();

ref class Resource {
    public any handle;

    constructor() {
        // 3. This successfully looks up 'io' in the global scope!
        this.handle = io.open("file.txt", "r");
    }

    destructor() {
        mockClose(this.handle); // Call the renamed function safely
    }
}
