// 1. Standard function with a default parameter and borrowed references
// We borrow 'name' so the caller retains ownership.
string greet(ref string name, string greeting = "Hello") {
    // Assuming Moksha automatically dereferences or handles string concatenation for references
    return greeting + ", " + name;
}

// 2. Multiple default parameters with borrows
void configureWindow(int width = 800, int height = 600, string title = "Moksha App") {
    // block body
}

void testDefaults() {
    string myName = "Alice";

    // Should compile: Borrows myName, injects "Hello" into the 2nd argument
    string a = greet(myName);

    // Should compile: myName is still valid here because it was only borrowed, not moved!
    string b = greet(myName, "Welcome");

    configureWindow();

    // Should compile: Overrides width, injects height and title
    configureWindow(1024);
}

// 3. Lambda/Closure default parameters with borrow checking
void testLambdaDefaults() {
    // A factory closure that can be called multiple times (Fn/FnMut equivalent)
    closure(int) -> closure(int) -> int makeMultiplier = (int factor = 2) => {
        return (int n) => {
            return n * factor;
        };
    };

    // Uses default argument (factor = 2).
    // Under borrow checking, calling the closure borrows it rather than moving it.
    closure(int) -> int doubleFunc = makeMultiplier();

    // Uses explicit argument (factor = 3).
    // Proves makeMultiplier wasn't moved by the previous call!
    closure(int) -> int tripleFunc = makeMultiplier(3);

    // Call doubleFunc multiple times to prove it is borrowed during execution, not moved.
    int res1 = doubleFunc(5);
    int res2 = doubleFunc(10); // Legal: doubleFunc is still valid

    // Same for tripleFunc
    int res3 = tripleFunc(5);
    int res4 = tripleFunc(10); // Legal: tripleFunc is still valid
}
