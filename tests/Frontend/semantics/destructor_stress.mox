generic Resource<T> {
    public T data;
    constructor(T d) {
        this.data = d;
    }
    destructor() {
        // Generic cleanup
    }
}

class Base {
    destructor() {
        print("Base cleaned");
    }
}

class Derived(Base) {
    destructor() {
        print("Derived cleaned");
    }
}

Resource<int> res = new Resource<int>(10);

try {
    Derived d = new Derived();
    throw 1;
    // AST must support unwinding `d` and `res` here
} catch (any e) {
    print("Caught exception");
}
