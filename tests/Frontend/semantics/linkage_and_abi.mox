// External C-linkage (Standard for OS syscalls)
// Verifies 'extern "C"' style parsing
extern "C" void kernel_panic(char* msg);

// Weak symbols (Allowing user-overrides for drivers)
// Verifies 'weak' keyword parsing
weak void default_irq_handler() {
    print("Unhandled IRQ");
}

// Custom Calling Conventions (Lowered to LLVM stdcall/fastcall)
extern "stdcall" void win32_api_call();
extern "fastcall" void optimized_helper();
