generic Map<K, V> {
    public K key;
    public V val;
    constructor(K k, V v) { this.key = k; this.val = v; }
}

generic List<T> {
    public T item;
    constructor(T i) { this.item = i; }
}

// 1. Parser must not treat `>>` or `>>>` as right-shift operators here.
Map<string, List<Map<int, string>>> deeplyNested =
    new Map<string, List<Map<int, string>>>(
        "root",
        new List<Map<int, string>>(new Map<int, string>(1, "leaf"))
    );

// 2. Parser must successfully differentiate the right-shift operator
// occurring immediately after generic brackets.
int shiftResult = deeplyNested.val.item.key >> 2;
