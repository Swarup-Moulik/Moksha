int track(int val) {
    print(val);
    return val;
}

void consume(int a, int b, int c) {}

// Must print 1, then 2, then 3 strictly.
// If it prints 3, 2, 1, your AST visitor or IR builder is walking backward.
consume(track(1), track(2), track(3));

// Pipe evaluation order
// track(10) MUST evaluate before track(20) is called
track(10) |> consume(track(20), track(30));
