int x = 10
int y = 20

// Ternary Operator
int max = (x > y) ? x : y

// Nested Ternary
string result = (x == y) ? "equal" : (x > y) ? "greater" : "lesser"

// Functional Casting Style (Parsed as CallExpr)
double d = double(x)

// Template Casting Style
// Requires 'cast' to be parsed as a generic function call
int rounded = cast<int>(3.14)

// Null Coalescing interactions
string? name = null
string display = name ?? "Guest"
