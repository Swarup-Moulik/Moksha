// Weak Async Function
weak async string fetchData() {
    return "Data"
}

// Weak Thread creation
new weak thread(() => {
    print("Background task")
})

// Async Function
async string fetchData2() {
    return "Data"
}

// Weak creation
new thread(() => {
    print("Background task")
})

// Await usage
string data = await fetchData()
