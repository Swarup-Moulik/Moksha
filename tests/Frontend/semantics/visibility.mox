// Base class defining different access levels
ref class Base {
    public int publicField = 1;
    protected int protectedField = 2;
    private int privateField = 3;

    public void testInternal() {
        // Legal: All members accessible inside their own class
        print(this.publicField);
        print(this.protectedField);
        print(this.privateField);
    }
}

// Subclass testing inheritance access
ref class Derived(Base) {
    public void testInheritance() {
        print(this.publicField);    // Legal: public
        print(this.protectedField); // Legal: protected is visible to children
        // print(this.privateField); // SHOULD ERROR: private not visible to children
    }
}

// --- Top-level Execution (Implicit Main) ---
// This acts as the "external" context
Base b = new Base();
print(b.publicField);    // Legal: public

// print(b.protectedField); // SHOULD ERROR: protected not visible to external caller
// print(b.privateField);   // SHOULD ERROR: private not visible to external caller

Derived d = new Derived();
d.testInheritance();
print(d.publicField);    // Legal: public inherited member
