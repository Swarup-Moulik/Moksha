void testInputVariations() {
    // 1. With a string prompt
    string name = input("What is your name? ");

    // 2. Without a prompt
    string rawData = input();

    // 3. Inline expression usage (testing string concatenation)
    string greeting = "Hello, " + input("Enter name: ") + "!";

    // 4. Passing as an argument
    print(input("Press Enter to continue..."));
}
