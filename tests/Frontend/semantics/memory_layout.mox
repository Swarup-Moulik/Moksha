// Linker placement for Multiboot/UEFI headers
// Verifies 'section' string extraction
section(".multiboot") align(4) packed struct MultibootHeader {
    unsigned int magic;
    unsigned int flags;
    unsigned int checksum;
}

// Page Table alignment requirement
// Verifies 'align' integer parsing
align(4096) unsigned long[512] kernel_pml4;

void check_layout() {
    // Verifies 'sizeof' on packed structs
    usize header_size = sizeof(MultibootHeader);
}
