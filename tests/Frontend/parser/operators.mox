int a = 10
int b = 20

// Arithmetic
int sum = a + b
int diff = a - b
int prod = a * b
int quot = a / b
int mod = a % b
int pow = a ** 2  // Power operator

// Bitwise
int bit_and = a & b
int bit_or = a | b
int bit_xor = a ^ b
int lshift = a << 2
int rshift = a >> 1
int not_a = ~a

// Comparison
bool eq = (a == b)
bool neq = (a != b)
bool lt = (a < b)
bool gte = (a >= b)

// Logical
bool logic = (a < b) && (b > 0) || !(a == 0)

// Assignments
a += 5
b *= 2
a++
b--
