// 1D Fixed Array (C-style)
int[5] fixedArr = [1, 2, 3, 4, 5]

// 1D Dynamic Array (Slice style)
int[] dynArr = [10, 20, 30]

// 2D Array (Matrix)
int[2][2] matrix = [
    [1, 0],
    [0, 1]
]

// Array of Strings
string[] names = ["Alice", "Bob", "Charlie"]

// Table (Map) syntax
table<string, int> scores = {
    "Alice": 100,
    "Bob": 95
}

// Accessing
int val = matrix[0][1]
int score = scores["Alice"]
