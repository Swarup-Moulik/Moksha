// --- 1. External Linkage & Variadics ---
// Verifies 'extern' parsing and linkage string extraction
extern "C" void printf(char* fmt, ...);

// --- 2. Linker Sections & Alignment ---
// Verifies 'section' and 'align' attributes on structs
section(".multiboot") align(4) packed struct MultibootHeader {
    unsigned int magic;
    unsigned int flags;
    unsigned int checksum;
}

// --- 3. Interrupt Handlers & Inline Assembly ---
// Verifies 'interrupt' attribute and 'asm' statement parsing
interrupt void timer_handler() {
    asm("pushaq");
    // Logic for timer tick...
    asm("popaq");
    asm("iretq");
}

// --- 4. Naked Functions ---
// Verifies 'naked' attribute for manual stack control
naked void syscall_stub() {
    asm("mov %rsp, %rax");
    asm("ret");
}

// --- 5. Volatile MMIO Access ---
// Verifies 'volatile' attribute on variables
extern volatile unsigned int LAPIC_ID_REG;
