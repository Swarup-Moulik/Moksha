println("--- [E2E] arrays_and_tables.mox ---")

// 1D Fixed Array (C-style)
int[5] fixedArr = [1, 2, 3, 4, 5]
println(fixedArr[2]) // Expected: 3

// 1D Dynamic Array (Slice style)
int[] dynArr = [10, 20, 30]
println(dynArr[0]) // Expected: 10

// 2D Array (Matrix)
int[2][2] matrix = [
    [1, 0],
    [0, 1]
]
println(matrix[1][1]) // Expected: 1

// Array of Strings
string[] names = ["Alice", "Bob", "Charlie"]
println(names[1]) // Expected: Bob

// Table (Map) syntax
table<string, int> scores = {
    "Alice": 100,
    "Bob": 95
}
println(scores["Alice"]) // Expected: 100
