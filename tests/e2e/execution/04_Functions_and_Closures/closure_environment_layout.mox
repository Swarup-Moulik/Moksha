println("--- [E2E] closure_environment_layout.mox ---")

void test_env() {
    int a = 10;
    string b = "hello layout";

    closure() -> void func = () => {
        println(a);
        println(b);
    };

    // The LLVM backend must construct a struct { i32, ptr } and pass it correctly
    func();
    // Expected: 10
    // Expected: hello layout
}

test_env();
