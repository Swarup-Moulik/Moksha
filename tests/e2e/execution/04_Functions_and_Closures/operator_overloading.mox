println("--- [E2E] operator_overloading.mox ---")

class Vector2 {
    public int x;
    public int y;

    constructor(int x, int y) {
        this.x = x;
        this.y = y;
    }

    // Binary Operator (+)
    Vector2 operator+(Vector2 other) {
        return new Vector2(this.x + other.x, this.y + other.y);
    }

    // Binary Operator (-)
    Vector2 operator-(Vector2 other) {
        return new Vector2(this.x - other.x, this.y - other.y);
    }

    // Equality Operator (==)
    bool operator==(Vector2 other) {
        return this.x == other.x && this.y == other.y;
    }

    // Unary Operator (-)
    Vector2 operator-() {
        return new Vector2(-this.x, -this.y);
    }
}

// Execution
Vector2 v1 = new Vector2(10, 20);
Vector2 v2 = new Vector2(5, 5);

// Should invoke operator+
Vector2 v3 = v1 + v2;
println(v3.x); // Expected: 15
println(v3.y); // Expected: 25

// Should invoke operator==
if (v3 == new Vector2(15, 25)) {
    println("Vector Math Works"); // Expected: Vector Math Works
}

// Should invoke unary operator-
Vector2 neg = -v1;
println(neg.x); // Expected: -10
println(neg.y); // Expected: -20
